-- ESP Variables
local espEnabled = false
local espObjects = {}

-- Function to create Box ESP around the player
local function createBoxESP(player)
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end

    -- Create ESP Box (Cube) based on player's size and position
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        local rootPart = character.HumanoidRootPart
        local boundingBox = humanoid.HipWidth * 2, humanoid.HipHeight * 2, humanoid.HipWidth * 2

        -- Create the ESP box (this will be a Part)
        local espBox = Instance.new("Part")
        espBox.Size = Vector3.new(boundingBox[1], boundingBox[2], boundingBox[3])
        espBox.Position = rootPart.Position
        espBox.Color = player.TeamColor.Color
        espBox.Anchored = true
        espBox.CanCollide = false
        espBox.Transparency = 0.6
        espBox.Parent = espGui

        -- Make the ESP box follow the player (updates on every frame)
        RunService.RenderStepped:Connect(function()
            if character and character:FindFirstChild("HumanoidRootPart") then
                espBox.CFrame = CFrame.new(character.HumanoidRootPart.Position) * CFrame.new(0, humanoid.HipHeight / 2, 0)
            end
        end)

        -- Store ESP Box for this player
        espObjects[player] = espBox
    end
end

-- Function to remove Box ESP around the player
local function removeBoxESP(player)
    if espObjects[player] then
        espObjects[player]:Destroy()
        espObjects[player] = nil
    end
end

-- Toggle ESP On
toggleOnButton.MouseButton1Click:Connect(function()
    espEnabled = true
    -- Create ESP for all players
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= Players.LocalPlayer then
            createBoxESP(player)
        end
    end
end)

-- Toggle ESP Off
toggleOffButton.MouseButton1Click:Connect(function()
    espEnabled = false
    -- Remove ESP from all players
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= Players.LocalPlayer then
            removeBoxESP(player)
        end
    end
end)

-- Close the GUI
closeButton.MouseButton1Click:Connect(function()
    espEnabled = false
    -- Remove ESP when the window is closed
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= Players.LocalPlayer then
            removeBoxESP(player)
        end
    end
    espGui:Destroy()
end)

-- Create ESP for new players joining
Players.PlayerAdded:Connect(function(player)
    if espEnabled then
        createBoxESP(player)
    end
end)

-- Remove ESP when players leave
Players.PlayerRemoving:Connect(function(player)
    removeBoxESP(player)
end)

-- Initial ESP setup for players already in the game
for _, player in pairs(Players:GetPlayers()) do
    if player ~= Players.LocalPlayer then
        createBoxESP(player)
    end
end

-- Custom Draggable Implementation
local isDragging = false
local dragInput, dragStart, dragPos

-- When user clicks on the title bar
title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        isDragging = true
        dragStart = input.Position
        dragInput = input
    end
end)

-- While the user is dragging the window
title.InputChanged:Connect(function(input)
    if isDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        bg.Position = UDim2.new(bg.Position.X.Scale, bg.Position.X.Offset + delta.X, bg.Position.Y.Scale, bg.Position.Y.Offset + delta.Y)
    end
end)

-- When the user stops dragging
title.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        isDragging = false
    end
end)

