local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local Camera = game:GetService("Workspace").CurrentCamera

-- Create the GUI
local espGui = Instance.new("ScreenGui")
espGui.Name = "ESP"
espGui.Parent = CoreGui

-- Create Background
local bg = Instance.new("Frame")
bg.Size = UDim2.new(0, 200, 0, 150)
bg.Position = UDim2.new(0.02, 0, 0.02, 0)
bg.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
bg.BorderSizePixel = 2
bg.BorderColor3 = Color3.fromRGB(100, 100, 100)
bg.Parent = espGui
bg.Active = true
bg.Draggable = true

-- Create Title
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 30)
title.Text = "ESP"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
title.TextSize = 24
title.Font = Enum.Font.SourceSans
title.Parent = bg

-- Create Toggle On Button
local toggleOnButton = Instance.new("TextButton")
toggleOnButton.Size = UDim2.new(0.5, 0, 0, 30)
toggleOnButton.Position = UDim2.new(0, 0, 0.25, 0)
toggleOnButton.Text = "On"
toggleOnButton.TextColor3 = Color3.fromRGB(255, 255, 255)
toggleOnButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
toggleOnButton.TextSize = 20
toggleOnButton.Font = Enum.Font.SourceSans
toggleOnButton.Parent = bg

-- Create Toggle Off Button
local toggleOffButton = Instance.new("TextButton")
toggleOffButton.Size = UDim2.new(0.5, 0, 0, 30)
toggleOffButton.Position = UDim2.new(0.5, 0, 0.25, 0)
toggleOffButton.Text = "Off"
toggleOffButton.TextColor3 = Color3.fromRGB(255, 255, 255)
toggleOffButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
toggleOffButton.TextSize = 20
toggleOffButton.Font = Enum.Font.SourceSans
toggleOffButton.Parent = bg

-- Create Close Button
local closeButton = Instance.new("TextButton")
closeButton.Size = UDim2.new(0, 40, 0, 30)
closeButton.Position = UDim2.new(1, -40, 0, 0)
closeButton.Text = "X"
closeButton.TextColor3 = Color3.fromRGB(255, 255, 255)
closeButton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
closeButton.TextSize = 20
closeButton.Font = Enum.Font.SourceSans
closeButton.Parent = bg

-- ESP Variables
local espEnabled = false
local espObjects = {}

-- Function to create ESP
local function createESP(player)
    local espBox = Instance.new("Frame")
    espBox.Size = UDim2.new(0, 100, 0, 100)
    espBox.Position = UDim2.new(0, 0, 0, 0)
    espBox.BackgroundColor3 = player.TeamColor.Color
    espBox.BackgroundTransparency = 0.5  -- Set transparency so the player is visible through the box
    espBox.BorderSizePixel = 2
    espBox.Parent = espGui
    espObjects[player] = espBox
    
    -- Follow player with ESP box
    RunService.RenderStepped:Connect(function()
        local character = player.Character
        if character and character:FindFirstChild("HumanoidRootPart") then
            local rootPart = character.HumanoidRootPart
            local screenPos = Camera:WorldToScreenPoint(rootPart.Position)

            if screenPos.Z > 0 then
                espBox.Visible = true
                espBox.Position = UDim2.new(0, screenPos.X - espBox.Size.X.Offset / 2, 0, screenPos.Y - espBox.Size.Y.Offset / 2)
            else
                espBox.Visible = false
            end
        else
            espBox.Visible = false
        end
    end)
end

-- Function to remove ESP
local function removeESP(player)
    if espObjects[player] then
        espObjects[player]:Destroy()
        espObjects[player] = nil
    end
end

-- Toggle ESP On/Off
toggleOnButton.MouseButton1Click:Connect(function()
    espEnabled = true
    -- Create ESP for all players
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= Players.LocalPlayer then
            createESP(player)
        end
    end
end)

toggleOffButton.MouseButton1Click:Connect(function()
    espEnabled = false
    -- Remove ESP from all players
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= Players.LocalPlayer then
            removeESP(player)
        end
    end
end)

-- Close the GUI
closeButton.MouseButton1Click:Connect(function()
    espEnabled = false
    -- Remove ESP when the window is closed
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= Players.LocalPlayer then
            removeESP(player)
        end
    end
    espGui:Destroy()
end)

-- Create ESP for new players joining
Players.PlayerAdded:Connect(function(player)
    if espEnabled then
        createESP(player)
    end
end)

-- Remove ESP when players leave
Players.PlayerRemoving:Connect(function(player)
    removeESP(player)
end)

-- Initial ESP setup for players already in the game
for _, player in pairs(Players:GetPlayers()) do
    if player ~= Players.LocalPlayer then
        createESP(player)
    end
end)
