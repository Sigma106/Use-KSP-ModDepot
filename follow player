local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Remove old GUI if it exists
local oldGui = LocalPlayer:FindFirstChild("PlayerGui"):FindFirstChild("FollowPlayerGui")
if oldGui then oldGui:Destroy() end

-- Create GUI
local screenGui = Instance.new("ScreenGui", LocalPlayer:WaitForChild("PlayerGui"))
screenGui.Name = "FollowPlayerGui"
screenGui.ResetOnSpawn = false

-- Create main frame (window)
local frame = Instance.new("Frame", screenGui)
frame.Size = UDim2.new(0, 280, 0, 150)
frame.Position = UDim2.new(0.5, -140, 0.8, 0)
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
frame.BorderSizePixel = 0
frame.Name = "MainFrame"

-- Make the frame manually draggable
local dragging = false
local dragStart, startPos

frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Title bar
local titleBar = Instance.new("TextLabel", frame)
titleBar.Size = UDim2.new(1, 0, 0, 30)
titleBar.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
titleBar.Text = "Spectate GUI (Third Person Follow)"
titleBar.TextColor3 = Color3.new(1,1,1)
titleBar.Font = Enum.Font.SourceSansBold
titleBar.TextSize = 18

-- Info label
local info = Instance.new("TextLabel", frame)
info.Position = UDim2.new(0, 10, 0, 35)
info.Size = UDim2.new(1, -20, 0, 40)
info.TextColor3 = Color3.new(1,1,1)
info.BackgroundTransparency = 1
info.Font = Enum.Font.SourceSansBold
info.TextSize = 20
info.Text = "Loading players..."

-- Button helper
local function newButton(txt, x, y, w, h)
    local btn = Instance.new("TextButton", frame)
    btn.Text = txt
    btn.Size = UDim2.new(0, w, 0, h)
    btn.Position = UDim2.new(0, x, 0, y)
    btn.BackgroundColor3 = Color3.fromRGB(50,50,50)
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 20
    return btn
end

-- Buttons
local toggleBtn = newButton("OFF", 10, 90, 60, 40)
local prevBtn = newButton("<", 80, 90, 50, 40)
local nextBtn = newButton(">", 140, 90, 50, 40)
local closeBtn = newButton("X", 230, 5, 30, 20)

-- Variables
local spectateOn = false
local playerList = {}
local index = 1
local conn = nil

-- Update list of players
local function refreshList()
    playerList = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(playerList, p)
        end
    end
    if index > #playerList then index = 1 end
end

-- Stop following
local function stop()
    if conn then conn:Disconnect() conn = nil end
    Camera.CameraType = Enum.CameraType.Custom
end

-- Start third-person spectate (fixed behind player)
local function follow(target)
    stop()
    if not target.Character then return end

    conn = RunService.RenderStepped:Connect(function()
        if not target.Character then return end
        local root = target.Character:FindFirstChild("HumanoidRootPart")
        if not root then return end

        Camera.CameraType = Enum.CameraType.Scriptable
        local camOffset = root.CFrame.LookVector * -10 + Vector3.new(0, 5, 0)
        Camera.CFrame = CFrame.new(root.Position + camOffset, root.Position)
    end)
end

-- UI Update
local function updateUI()
    if #playerList == 0 then
        info.Text = "No players."
    else
        local p = playerList[index]
        info.Text = "Following: " .. p.Name .. " (" .. p.DisplayName .. ")"
    end
end

-- Toggle spectate
toggleBtn.MouseButton1Click:Connect(function()
    spectateOn = not spectateOn
    toggleBtn.Text = spectateOn and "ON" or "OFF"
    if spectateOn and playerList[index] then
        follow(playerList[index])
    else
        stop()
        info.Text = "Spectate OFF"
    end
end)

-- Next/Prev
nextBtn.MouseButton1Click:Connect(function()
    if #playerList == 0 then return end
    index = index + 1
    if index > #playerList then index = 1 end
    updateUI()
    if spectateOn then follow(playerList[index]) end
end)

prevBtn.MouseButton1Click:Connect(function()
    if #playerList == 0 then return end
    index = index - 1
    if index < 1 then index = #playerList end
    updateUI()
    if spectateOn then follow(playerList[index]) end
end)

-- Close GUI
closeBtn.MouseButton1Click:Connect(function()
    stop()
    screenGui:Destroy()
end)

-- Player list updates
Players.PlayerAdded:Connect(refreshList)
Players.PlayerRemoving:Connect(refreshList)

-- Initial setup
refreshList()
updateUI()
