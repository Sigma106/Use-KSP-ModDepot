task.wait(3)

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")

local player = Players.LocalPlayer

local webhook = "https://discord.com/api/webhooks/1551288660706467891/-_9fa9SiMAPSmmruviWP0hOVHh2bGgD7IWxz0DfMyoK2pOMPsv8KpngyJju6gfvDrry2"

local request = request or http_request or syn.request

local placeId = game.PlaceId
local jobId = game.JobId

local gameName = "Unknown Game"

pcall(function()
	gameName = MarketplaceService:GetProductInfo(placeId).Name
end)

local function getAvatarUrls(userId)
	local headshotUrl
	local fullAvatarUrl

	pcall(function()
		local response = request({
			Url =
				"https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds="
				.. tostring(userId)
				.. "&size=420x420&format=Png&isCircular=false",
			Method = "GET"
		})

		if response and response.Body then
			local data = HttpService:JSONDecode(response.Body)

			if data.data and data.data[1] then
				headshotUrl = data.data[1].imageUrl
			end
		end
	end)

	pcall(function()
		local response = request({
			Url =
				"https://thumbnails.roblox.com/v1/users/avatar?userIds="
				.. tostring(userId)
				.. "&size=720x720&format=Png&isCircular=false",
			Method = "GET"
		})

		if response and response.Body then
			local data = HttpService:JSONDecode(response.Body)

			if data.data and data.data[1] then
				fullAvatarUrl = data.data[1].imageUrl
			end
		end
	end)

	return headshotUrl, fullAvatarUrl
end

local headshotUrl, fullAvatarUrl = getAvatarUrls(player.UserId)

local serverLink =
	"https://www.roblox.com/games/start?placeId="
	.. tostring(placeId)
	.. "&gameInstanceId="
	.. tostring(jobId)

local embed = {
	title = "Player Joined",
	color = 3447003,

	fields = {
		{
			name = "Username",
			value = "@" .. player.Name,
			inline = true
		},

		{
			name = "Nickname",
			value = player.DisplayName,
			inline = true
		},

		{
			name = "Game",
			value = gameName,
			inline = false
		},

		{
			name = "Server ID",
			value = "`" .. tostring(jobId) .. "`",
			inline = false
		},

		{
			name = "Join Server",
			value = "[Click to Join Roblox Server](" .. serverLink .. ")",
			inline = false
		}
	}
}

if headshotUrl then
	embed.thumbnail = {
		url = headshotUrl
	}
end

local embeds = {
	embed
}

if fullAvatarUrl then
	table.insert(embeds, {
		title = "Full Avatar",
		color = 3447003,

		image = {
			url = fullAvatarUrl
		}
	})
end

local payload = {
	username = "Roblox Tracker",
	embeds = embeds
}

local success, response = pcall(function()
	return request({
		Url = webhook,
		Method = "POST",

		Headers = {
			["Content-Type"] = "application/json"
		},

		Body = HttpService:JSONEncode(payload)
	})
end)

if success then
	print("Discord Status:", response.StatusCode)
	print("Discord Response:", response.Body)
else
	warn("Discord request failed:", response)
end
