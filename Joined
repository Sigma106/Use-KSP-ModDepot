local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")

local player = Players.LocalPlayer

local webhook = "https://discord.com/api/webhooks/1551288660706467891/-_9fa9SiMAPSmmruviWP0hOVHh2bGgD7IWxz0DfMyoK2pOMPsv8KpngyJju6gfvDrry2"

local request = request or http_request or syn.request

local placeId = game.PlaceId
local jobId = game.JobId

local gameName = "Unknown Game"

pcall(function()
    gameName = MarketplaceService:GetProductInfo(placeId).Name
end)

local serverLink =
    "https://www.roblox.com/games/start?placeId="
    .. tostring(placeId)
    .. "&gameInstanceId="
    .. tostring(jobId)

-- Get PLACE ICON
local function getGameIcon()
    local gameIconUrl

    pcall(function()
        local response = request({
            Url =
                "https://thumbnails.roblox.com/v1/places/gameicons?placeIds="
                .. tostring(placeId)
                .. "&size=512x512&format=Png&isCircular=false",
            Method = "GET"
        })

        if response and response.Body then
            local data = HttpService:JSONDecode(response.Body)

            if data.data and data.data[1] then
                gameIconUrl = data.data[1].imageUrl
            end
        end
    end)

    return gameIconUrl
end

-- Get PLAYER FACE / HEADSHOT
local function getPlayerFace()
    local faceUrl

    pcall(function()
        local response = request({
            Url =
                "https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds="
                .. tostring(player.UserId)
                .. "&size=420x420&format=Png&isCircular=false",
            Method = "GET"
        })

        if response and response.Body then
            local data = HttpService:JSONDecode(response.Body)

            if data.data and data.data[1] then
                faceUrl = data.data[1].imageUrl
            end
        end
    end)

    return faceUrl
end

local gameIconUrl = getGameIcon()
local playerFaceUrl = getPlayerFace()

local embed = {
    title = "Player Joined",
    color = 3447003,

    fields = {
        {
            name = "Username",
            value = "@" .. player.Name,
            inline = true
        },

        {
            name = "Nickname",
            value = player.DisplayName,
            inline = true
        },

        {
            name = "Game",
            value = gameName,
            inline = false
        },

        {
            name = "Server ID",
            value = "`" .. tostring(jobId) .. "`",
            inline = false
        },

        {
            name = "Join Server",
            value = "[Click to Join Roblox Server](" .. serverLink .. ")",
            inline = false
        }
    }
}

-- PLACE ICON beside the game name at the TOP
if gameIconUrl then
    embed.author = {
        name = gameName,
        icon_url = gameIconUrl
    }
end

-- PLAYER FACE on the TOP-RIGHT
if playerFaceUrl then
    embed.thumbnail = {
        url = playerFaceUrl
    }
end

local payload = {
    username = "Roblox Tracker",

    embeds = {
        embed
    }
}

task.wait(3)

local success, response = pcall(function()
    return request({
        Url = webhook,
        Method = "POST",

        Headers = {
            ["Content-Type"] = "application/json"
        },

        Body = HttpService:JSONEncode(payload)
    })
end)

if success then
    print("Discord Status:", response.StatusCode)
    print("Discord Response:", response.Body)
else
    warn("Discord request failed:", response)
end
