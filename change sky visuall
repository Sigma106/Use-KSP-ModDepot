-- Sky & Global Texture Changer GUI (all game textures)
-- Executor-safe (CoreGui)

local Lighting = game:GetService("Lighting")
local CoreGui = game:GetService("CoreGui")
local Workspace = game:GetService("Workspace")

-- Remove old GUI if exists
pcall(function()
    CoreGui:FindFirstChild("SkyTextureGui"):Destroy()
end)

-- Save original skies
local originalSkies = {}
for _, s in pairs(Lighting:GetChildren()) do
    if s:IsA("Sky") then
        table.insert(originalSkies, s:Clone())
    end
end

-- Save original textures of ALL parts/decals/meshes in Workspace
local originalTextures = {}

local function saveOriginalTextures()
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Decal") or obj:IsA("Texture") then
            originalTextures[obj] = obj.Texture
        elseif obj:IsA("MeshPart") then
            originalTextures[obj] = obj.TextureID
        elseif obj:IsA("SpecialMesh") then
            originalTextures[obj] = obj.TextureId
        end
    end
end

saveOriginalTextures()

-- Clear all skies from Lighting
local function clearSkies()
    for _, s in pairs(Lighting:GetChildren()) do
        if s:IsA("Sky") then
            s:Destroy()
        end
    end
end

-- Set Epic Face sky
local function epicFaceSky()
    clearSkies()
    local sky = Instance.new("Sky")
    sky.Name = "EpicFace"
    local id = "rbxassetid://7817004"
    sky.SkyboxBk = id
    sky.SkyboxDn = id
    sky.SkyboxFt = id
    sky.SkyboxLf = id
    sky.SkyboxRt = id
    sky.SkyboxUp = id
    sky.StarCount = 3000
    sky.CelestialBodiesShown = true
    sky.Parent = Lighting
end

-- Set Night sky
local function nightSky()
    clearSkies()
    local sky = Instance.new("Sky")
    sky.Name = "Night"
    sky.SkyboxBk = "rbxassetid://6285719338"
    sky.SkyboxDn = "rbxassetid://6285721078"
    sky.SkyboxFt = "rbxassetid://6285722964"
    sky.SkyboxLf = "rbxassetid://6285724682"
    sky.SkyboxRt = "rbxassetid://6285726335"
    sky.SkyboxUp = "rbxassetid://6285730635"
    sky.CelestialBodiesShown = false
    sky.Parent = Lighting
end

-- Restore original skies
local function restoreSky()
    clearSkies()
    for _, s in pairs(originalSkies) do
        s:Clone().Parent = Lighting
    end
end

-- Apply Epic Face texture to ALL applicable objects in the entire Workspace
local EPIC_TEXTURE = "rbxassetid://7817004"
local function applyEpicTextures()
    for obj, _ in pairs(originalTextures) do
        if obj and obj.Parent then
            if obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Texture = EPIC_TEXTURE
            elseif obj:IsA("MeshPart") then
                obj.TextureID = EPIC_TEXTURE
            elseif obj:IsA("SpecialMesh") then
                obj.TextureId = EPIC_TEXTURE
            end
        end
    end
end

-- Restore ALL textures to their original values
local function restoreTextures()
    for obj, tex in pairs(originalTextures) do
        if obj and obj.Parent then
            if obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Texture = tex
            elseif obj:IsA("MeshPart") then
                obj.TextureID = tex
            elseif obj:IsA("SpecialMesh") then
                obj.TextureId = tex
            end
        end
    end
end

