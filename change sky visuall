texPage.Parent = main
texPage.Visible = false

-- Buttons helper
local function button(parent, text, y, callback)
    local b = Instance.new("TextButton", parent)
    b.Size = UDim2.new(0.85,0,0,36)
    b.Position = UDim2.new(0.075,0,y,0)
    b.Text = text
    b.BackgroundColor3 = Color3.fromRGB(70,130,220)
    b.TextColor3 = Color3.new(1,1,1)
    b.Font = Enum.Font.GothamBold
    Instance.new("UICorner", b)
    b.MouseButton1Click:Connect(callback)
end

-- Sky buttons
button(skyPage,"Epic Face Sky",0.1,epicFaceSky)
button(skyPage,"Night Sky",0.35,nightSky)
button(skyPage,"Restore Sky",0.6,restoreSky)

-- Texture buttons
button(texPage,"Epic Face All Textures",0.25,applyEpicTextures)
button(texPage,"Restore Textures",0.55,restoreTextures)

-- Tab switching
tabSky.MouseButton1Click:Connect(function()
    skyPage.Visible = true
    texPage.Visible = false
    tabSky.BackgroundColor3 = Color3.fromRGB(50,50,50)
    tabTex.BackgroundColor3 = Color3.fromRGB(35,35,35)
end)

tabTex.MouseButton1Click:Connect(function()
    skyPage.Visible = false
    texPage.Visible = true
    tabTex.BackgroundColor3 = Color3.fromRGB(50,50,50)
    tabSky.BackgroundColor3 = Color3.fromRGB(35,35,35)
end)

print("Sky & Texture GUI loaded")
