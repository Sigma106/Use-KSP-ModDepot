startBtn.Position = UDim2.new(0.5,-130,0,90)
startBtn.Text = "START"
startBtn.Font = Enum.Font.GothamBold
startBtn.TextSize = 16
startBtn.TextColor3 = Color3.new(1,1,1)
startBtn.BackgroundColor3 = Color3.fromRGB(50,170,50)
startBtn.Parent = main

-- STOP BUTTON
local stopBtn = Instance.new("TextButton")
stopBtn.Size = UDim2.new(0,120,0,40)
stopBtn.Position = UDim2.new(0.5,10,0,90)
stopBtn.Text = "STOP"
stopBtn.Font = Enum.Font.GothamBold
stopBtn.TextSize = 16
stopBtn.TextColor3 = Color3.new(1,1,1)
stopBtn.BackgroundColor3 = Color3.fromRGB(170,50,50)
stopBtn.Parent = main

-- DRAGGING
local dragging = false
local dragStart, startPos

titleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = main.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		main.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

-- CHARACTER LOGIC (FINAL & SAFE)
local function onCharacter(char)
	local humanoid = char:WaitForChild("Humanoid")
	local root = char:WaitForChild("HumanoidRootPart")

	currentHumanoid = humanoid

	-- RESTORE SPEED
	humanoid.WalkSpeed = currentSpeed

	-- TELEPORT AFTER RESPAWN
	if enabled and lastDeathCFrame then
		task.wait()
		root.CFrame = lastDeathCFrame
	end

	-- SAVE POSITION & SPEED ON DEATH
	humanoid.Died:Connect(function()
		if enabled then
			lastDeathCFrame = root.CFrame
		end
		currentSpeed = humanoid.WalkSpeed
	end)
end

player.CharacterAdded:Connect(onCharacter)

if player.Character then
	onCharacter(player.Character)
end

-- BUTTON LOGIC
startBtn.MouseButton1Click:Connect(function()
	enabled = true
	startBtn.Text = "RUNNING"
end)

stopBtn.MouseButton1Click:Connect(function()
	enabled = false
	lastDeathCFrame = nil
	startBtn.Text = "START"
end)

-- 🟢 PUBLIC SPEED API (FOR ANY SPEED GUI)
_G.SetPlayerSpeed = function(speed)
	currentSpeed = speed
	if currentHumanoid then
		currentHumanoid.WalkSpeed = speed
	end
end
