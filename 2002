-- Services
local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- Character / Humanoid
local function getHumanoid()
    local character = player.Character or player.CharacterAdded:Wait()
    return character:WaitForChild("Humanoid")
end

local humanoid = getHumanoid()
local normalSpeed = humanoid.WalkSpeed -- Save original speed

-- Update humanoid on respawn
player.CharacterAdded:Connect(function(char)
    humanoid = char:WaitForChild("Humanoid")
    humanoid.WalkSpeed = normalSpeed
end)

-- Create GUI
local screenGui = Instance.new("ScreenGui", game.CoreGui)
screenGui.Name = "SpeedBoostGUI"

local frame = Instance.new("Frame", screenGui)
local title = Instance.new("TextLabel", frame)
local textBox = Instance.new("TextBox", frame)
local setButton = Instance.new("TextButton", frame)
local normalButton = Instance.new("TextButton", frame)
local closeButton = Instance.new("TextButton", frame)

-- Frame
frame.Size = UDim2.new(0, 300, 0, 260)
frame.Position = UDim2.new(0.5, -150, 0.5, -130)
frame.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
frame.AnchorPoint = Vector2.new(0.5, 0.5)
frame.Active = true
frame.Draggable = true

-- Title
title.Size = UDim2.new(1, 0, 0, 40)
title.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
title.Text = "Speed Boost GUI"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextScaled = true
title.Font = Enum.Font.GothamBold
title.BorderSizePixel = 0

-- Close Button
closeButton.Size = UDim2.new(0, 30, 0, 30)
closeButton.Position = UDim2.new(1, -35, 0, 5)
closeButton.Text = "X"
closeButton.BackgroundColor3 = Color3.fromRGB(180, 60, 60)
closeButton.TextColor3 = Color3.new(1, 1, 1)
closeButton.Font = Enum.Font.GothamBold
closeButton.TextScaled = true

-- TextBox
textBox.Size = UDim2.new(0.8, 0, 0, 40)
textBox.Position = UDim2.new(0.1, 0, 0.35, 0)
textBox.PlaceholderText = "Enter Speed"
textBox.TextScaled = true
textBox.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
textBox.TextColor3 = Color3.new(1,1,1)
textBox.BorderSizePixel = 0

-- Set Speed Button
setButton.Size = UDim2.new(0.8, 0, 0, 40)
setButton.Position = UDim2.new(0.1, 0, 0.55, 0)
setButton.Text = "Set Speed"
setButton.BackgroundColor3 = Color3.fromRGB(70, 130, 180)
setButton.TextColor3 = Color3.new(1,1,1)
setButton.Font = Enum.Font.GothamBold
setButton.TextScaled = true

-- Normal Speed Button
normalButton.Size = UDim2.new(0.8, 0, 0, 40)
normalButton.Position = UDim2.new(0.1, 0, 0.75, 0)
normalButton.Text = "Normal Speed"
normalButton.BackgroundColor3 = Color3.fromRGB(100, 180, 100)
normalButton.TextColor3 = Color3.new(1,1,1)
normalButton.Font = Enum.Font.GothamBold
normalButton.TextScaled = true

-- Functions
local function setSpeed()
    local speed = tonumber(textBox.Text)
    if speed then
        humanoid.WalkSpeed = speed
    end
end

local function resetSpeed()
    humanoid.WalkSpeed = normalSpeed
end

-- Connections
setButton.MouseButton1Click:Connect(setSpeed)
normalButton.MouseButton1Click:Connect(resetSpeed)

closeButton.MouseButton1Click:Connect(function()
    resetSpeed()
    screenGui:Destroy()
end)

-- Reset speed on death
humanoid.Died:Connect(resetSpeed)
