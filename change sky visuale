-- Epic Face Full World Changer (Automatic + GUI)
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")

local EPIC_TEXTURE = "rbxassetid://7817004"

-- Remove old GUI if exists
pcall(function() CoreGui:FindFirstChild("EpicFaceGui"):Destroy() end)

-- Save original properties
local originalProps = {}
local function saveOriginal(obj)
    pcall(function()
        if obj:IsA("Decal") or obj:IsA("Texture") then
            originalProps[obj] = {Texture = obj.Texture}
        elseif obj:IsA("MeshPart") then
            originalProps[obj] = {TextureID=obj.TextureID, Material=obj.Material, Color=obj.Color}
        elseif obj:IsA("SpecialMesh") then
            originalProps[obj] = {TextureId=obj.TextureId}
        elseif obj:IsA("SurfaceAppearance") then
            originalProps[obj] = {Texture=obj.Texture}
        elseif obj:IsA("BasePart") then
            originalProps[obj] = {Material=obj.Material, Color=obj.Color}
        end
    end)
end

local function saveAllOriginals()
    for _, obj in pairs(Workspace:GetDescendants()) do
        saveOriginal(obj)
    end
end
saveAllOriginals()

-- Sky handling
local originalSkies = {}
for _, s in pairs(Lighting:GetChildren()) do
    if s:IsA("Sky") then table.insert(originalSkies,s:Clone()) end
end

local function clearSkies()
    for _, s in pairs(Lighting:GetChildren()) do
        if s:IsA("Sky") then s:Destroy() end
    end
end

local function setEpicSky()
    clearSkies()
    local sky = Instance.new("Sky")
    sky.Name = "EpicFace"
    sky.SkyboxBk = EPIC_TEXTURE
    sky.SkyboxDn = EPIC_TEXTURE
    sky.SkyboxFt = EPIC_TEXTURE
    sky.SkyboxLf = EPIC_TEXTURE
    sky.SkyboxRt = EPIC_TEXTURE
    sky.SkyboxUp = EPIC_TEXTURE
    sky.StarCount = 3000
    sky.CelestialBodiesShown = true
    sky.Parent = Lighting
end

local function restoreSky()
    clearSkies()
    for _, s in pairs(originalSkies) do
        s:Clone().Parent = Lighting
    end
end

-- Apply Epic Face to all objects
local function applyEpicWorld(obj)
    obj = obj or Workspace
    for _, o in pairs(obj:GetDescendants()) do
        pcall(function()
            if o:IsA("Decal") or o:IsA("Texture") then
                o.Texture = EPIC_TEXTURE
            elseif o:IsA("MeshPart") then
                o.TextureID = EPIC_TEXTURE
                o.Material = Enum.Material.SmoothPlastic
                o.Color = Color3.new(1,1,1)
            elseif o:IsA("SpecialMesh") then
                o.TextureId = EPIC_TEXTURE
            elseif o:IsA("SurfaceAppearance") then
                o.Texture = EPIC_TEXTURE
            elseif o:IsA("BasePart") then
                o.Material = Enum.Material.SmoothPlastic
                o.Color = Color3.new(1,1,1)
            end
        end)
    end
end

-- Restore original world
local function restoreWorld()
    restoreSky()
    for obj, props in pairs(originalProps) do
        if obj and obj.Parent then
            pcall(function()
                for k,v in pairs(props) do obj[k]=v end
            end)
        end
    end
end

-- Auto-apply Epic Face to new parts
Workspace.DescendantAdded:Connect(function(obj)
    wait(0.05)
    applyEpicWorld(obj)
end)

-- Auto-apply to player characters
Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function(char)
        wait(0.5)
        applyEpicWorld(char)
    end)
end)

-- GUI
local gui = Instance.new("ScreenGui")
gui.Name = "EpicFaceGui"
gui.Parent = CoreGui

local main = Instance.new("Frame")
main.Size = UDim2.new(0,300,0,220)
main.Position = UDim2.new(0.5,-150,0.5,-110)
main.BackgroundColor3 = Color3.fromRGB(30,30,30)
main.Active = true
main.Draggable = true
main.Parent = gui

local function createButton(parent,text,posY,callback)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(0.8,0,0,40)
    btn.Position = UDim2.new(0.1,0,posY,0)
    btn.Text = text
    btn.BackgroundColor3 = Color3.fromRGB(70,130,220)
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 18
    btn.MouseButton1Click:Connect(callback)
    return btn
end

createButton(main,"Epic Face Everything",0.05,function()
    setEpicSky()
    applyEpicWorld()
end)

createButton(main,"Restore Everything",0.25,restoreWorld)
createButton(main,"Epic Face Sky Only",0.55,setEpicSky)
createButton(main,"Restore Sky",0.75,restoreSky)

-- Close button
local close = Instance.new("TextButton", main)
close.Size = UDim2.new(0,30,0,30)
close.Position = UDim2.new(1,-35,0,5)
close.Text = "X"
close.BackgroundColor3 = Color3.fromRGB(170,60,60)
close.TextColor3 = Color3.new(1,1,1)
close.Font = Enum.Font.GothamBold
close.MouseButton1Click:Connect(function() gui:Destroy() end)

print("Epic Face World Changer loaded")
