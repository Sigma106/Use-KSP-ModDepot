local selectedPlayer = nil

local function updatePlayerInfo(username)
    print("[updatePlayerInfo] Looking for player with username:", username)
    local target = Players:FindFirstChild(username)

    if not target then
        print("[updatePlayerInfo] Player not found:", username)
        avatarImage.Image = "rbxasset://textures/ui/GuiImagePlaceholder.png"
        displayNameLabel.Text = "Player not found"
        usernameLabel.Text = username
        selectedPlayer = nil
        return
    end

    print("[updatePlayerInfo] Player found:", target.Name)
    displayNameLabel.Text = target.DisplayName
    usernameLabel.Text = "@" .. target.Name

    local userId = target.UserId
    local thumbUrl
    local success, err = pcall(function()
        thumbUrl = Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
    end)

    if success and thumbUrl and thumbUrl ~= "" then
        avatarImage.Image = thumbUrl
        print("[updatePlayerInfo] Avatar loaded:", thumbUrl)
    else
        avatarImage.Image = "rbxasset://textures/ui/GuiImagePlaceholder.png"
        print("[updatePlayerInfo] Failed to load avatar:", err)
    end
    selectedPlayer = target
end

inputBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local text = inputBox.Text:match("^%s*(.-)%s*$") -- trim spaces
        if text ~= "" then
            updatePlayerInfo(text)
        end
    end
end)

teleportBtn.MouseButton1Click:Connect(function()
    if not selectedPlayer then
        print("[Teleport] No player selected!")
        return
    end

    if not selectedPlayer.Character then
        print("[Teleport] Selected player's character not loaded!")
        return
    end

    local hrp = selectedPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then
        print("[Teleport] Selected player's HumanoidRootPart not found!")
        return
    end

    local myChar = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")

    if not myHRP then
        print("[Teleport] Your HumanoidRootPart not found!")
        return
    end

    print("[Teleport] Teleporting to", selectedPlayer.Name)
    myHRP.CFrame = hrp.CFrame + Vector3.new(3, 0, 0)
end)
