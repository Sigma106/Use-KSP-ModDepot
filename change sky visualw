-- FULL WORLD Epic Face Changer GUI (Tabbed)
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")

local EPIC_TEXTURE = "rbxassetid://7817004"
local NIGHT_SKY = {
    SkyboxBk = "rbxassetid://6285719338",
    SkyboxDn = "rbxassetid://6285721078",
    SkyboxFt = "rbxassetid://6285722964",
    SkyboxLf = "rbxassetid://6285724682",
    SkyboxRt = "rbxassetid://6285726335",
    SkyboxUp = "rbxassetid://6285730635"
}

-- Remove old GUI
pcall(function() CoreGui:FindFirstChild("EpicFaceGui"):Destroy() end)

-- Save original skies
local originalSkies = {}
for _, s in pairs(Lighting:GetChildren()) do
    if s:IsA("Sky") then
        table.insert(originalSkies, s:Clone())
    end
end

-- Save original textures/colors/materials
local originalProps = {}
local function saveAllOriginal()
    for _, obj in pairs(Workspace:GetDescendants()) do
        pcall(function()
            originalProps[obj] = {}
            if obj:IsA("Decal") or obj:IsA("Texture") then
                originalProps[obj].Texture = obj.Texture
            elseif obj:IsA("MeshPart") then
                originalProps[obj].TextureID = obj.TextureID
                originalProps[obj].Material = obj.Material
                originalProps[obj].Color = obj.Color
            elseif obj:IsA("SpecialMesh") then
                originalProps[obj].TextureId = obj.TextureId
            elseif obj:IsA("SurfaceAppearance") then
                originalProps[obj].Texture = obj.Texture
            elseif obj:IsA("BasePart") then
                originalProps[obj].Material = obj.Material
                originalProps[obj].Color = obj.Color
            end
        end)
    end
end
saveAllOriginal()

-- Sky Functions
local function clearSkies()
    for _, s in pairs(Lighting:GetChildren()) do
        if s:IsA("Sky") then s:Destroy() end
    end
end

local function setEpicFaceSky()
    clearSkies()
    local sky = Instance.new("Sky")
    sky.Name = "EpicFace"
    sky.SkyboxBk = EPIC_TEXTURE
    sky.SkyboxDn = EPIC_TEXTURE
    sky.SkyboxFt = EPIC_TEXTURE
    sky.SkyboxLf = EPIC_TEXTURE
    sky.SkyboxRt = EPIC_TEXTURE
    sky.SkyboxUp = EPIC_TEXTURE
    sky.StarCount = 3000
    sky.CelestialBodiesShown = true
    sky.Parent = Lighting
end

local function setNightSky()
    clearSkies()
    local sky = Instance.new("Sky")
    sky.Name = "Night"
    for k,v in pairs(NIGHT_SKY) do
        sky[k] = v
    end
    sky.CelestialBodiesShown = false
    sky.Parent = Lighting
end

local function restoreSky()
    clearSkies()
    for _, s in pairs(originalSkies) do
        s:Clone().Parent = Lighting
    end
end

-- Apply Epic Face to all parts, meshes, decals, surface appearances, BaseParts
local function applyEpicWorld()
    setEpicFaceSky()
    for _, obj in pairs(Workspace:GetDescendants()) do
        pcall(function()
            if obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Texture = EPIC_TEXTURE
            elseif obj:IsA("MeshPart") then
                obj.TextureID = EPIC_TEXTURE
                obj.Material = Enum.Material.SmoothPlastic
                obj.Color = Color3.new(1,1,1)
            elseif obj:IsA("SpecialMesh") then
                obj.TextureId = EPIC_TEXTURE
            elseif obj:IsA("SurfaceAppearance") then
                obj.Texture = EPIC_TEXTURE
            elseif obj:IsA("BasePart") then
                obj.Material = Enum.Material.SmoothPlastic
                obj.Color = Color3.new(1,1,1)
            end
        end)
    end
end

-- Restore original textures/colors/materials
local function restoreWorld()
    restoreSky()
    for obj, props in pairs(originalProps) do
        if obj and obj.Parent then
            pcall(function()
                for k,v in pairs(props) do
                    obj[k] = v
                end
            end)
        end
    end
end

