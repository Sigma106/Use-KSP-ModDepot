-- FULL WORLD Epic Face Changer GUI
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")

local EPIC_TEXTURE = "rbxassetid://7817004"

-- Remove old GUI
pcall(function() CoreGui:FindFirstChild("EpicFaceGui"):Destroy() end)

-- Save original skies
local originalSkies = {}
for _, s in pairs(Lighting:GetChildren()) do
    if s:IsA("Sky") then
        table.insert(originalSkies, s:Clone())
    end
end

-- Save original textures for restoration
local originalTextures = {}

local function saveAllOriginal()
    for _, obj in pairs(Workspace:GetDescendants()) do
        pcall(function()
            if obj:IsA("Decal") or obj:IsA("Texture") then
                originalTextures[obj] = originalTextures[obj] or {}
                originalTextures[obj].Texture = obj.Texture
            elseif obj:IsA("MeshPart") then
                originalTextures[obj] = originalTextures[obj] or {}
                originalTextures[obj].TextureID = obj.TextureID
            elseif obj:IsA("SpecialMesh") then
                originalTextures[obj] = originalTextures[obj] or {}
                originalTextures[obj].TextureId = obj.TextureId
            elseif obj:IsA("SurfaceAppearance") then
                originalTextures[obj] = originalTextures[obj] or {}
                originalTextures[obj].Texture = obj.Texture
            elseif obj:IsA("BasePart") then
                originalTextures[obj] = originalTextures[obj] or {}
                originalTextures[obj].Material = obj.Material
                originalTextures[obj].Color = obj.Color
            end
        end)
    end
end

saveAllOriginal()

-- Sky functions
local function clearSkies()
    for _, s in pairs(Lighting:GetChildren()) do
        if s:IsA("Sky") then s:Destroy() end
    end
end

local function epicFaceSky()
    clearSkies()
    local sky = Instance.new("Sky")
    sky.Name = "EpicFace"
    local id = EPIC_TEXTURE
    sky.SkyboxBk,id,id
    sky.SkyboxBk, sky.SkyboxDn, sky.SkyboxFt = id,id,id
    sky.SkyboxLf, sky.SkyboxRt, sky.SkyboxUp = id,id,id
    sky.StarCount = 3000
    sky.CelestialBodiesShown = true
    sky.Parent = Lighting
end

local function restoreSky()
    clearSkies()
    for _, s in pairs(originalSkies) do
        s:Clone().Parent = Lighting
    end
end

-- Apply Epic Face texture to EVERYTHING
local function applyEpicWorld()
    epicFaceSky() -- change sky too
    for _, obj in pairs(Workspace:GetDescendants()) do
        pcall(function()
            if obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Texture = EPIC_TEXTURE
            elseif obj:IsA("MeshPart") then
                obj.TextureID = EPIC_TEXTURE
            elseif obj:IsA("SpecialMesh") then
                obj.TextureId = EPIC_TEXTURE
            elseif obj:IsA("SurfaceAppearance") then
                obj.Texture = EPIC_TEXTURE
            elseif obj:IsA("BasePart") then
                obj.Color = Color3.new(1,1,1)
                obj.Material = Enum.Material.SmoothPlastic
            end
        end)
    end
end

-- Restore everything
local function restoreWorld()
    restoreSky()
    for obj, props in pairs(originalTextures) do
        if obj and obj.Parent then
            pcall(function()
                for k,v in pairs(props) do
                    obj[k] = v
                end
            end)
        end
    end
end

