    worldPage.Visible = false
    tabSky.BackgroundColor3 = Color3.fromRGB(60,60,60)
    tabWorld.BackgroundColor3 = Color3.fromRGB(40,40,40)
end)

tabWorld.MouseButton1Click:Connect(function()
