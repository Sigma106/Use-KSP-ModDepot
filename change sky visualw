-- Button Creator
local function createButton(parent,text,y,callback)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(0.85,0,0,36)
    btn.Position = UDim2.new(0.075,0,y,0)
    btn.Text = text
    btn.BackgroundColor3 = Color3.fromRGB(80,130,220)
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.GothamBold
    Instance.new("UICorner", btn)
    btn.MouseButton1Click:Connect(callback)
end

-- Sky Buttons
createButton(skyPage,"Epic Face Sky",0.1,setEpicFaceSky)
createButton(skyPage,"Night Sky",0.35,setNightSky)
createButton(skyPage,"Restore Sky",0.6,restoreSky)

-- World Buttons
createButton(worldPage,"Epic Face Everything",0.1,applyEpicWorld)
createButton(worldPage,"Restore Everything",0.5,restoreWorld)

