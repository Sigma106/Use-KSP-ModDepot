local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Clean up old GUI if exists
local existingGui = LocalPlayer:FindFirstChild("PlayerGui"):FindFirstChild("FollowPlayerGui")
if existingGui then
    existingGui:Destroy()
end

-- Create ScreenGui
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "FollowPlayerGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

-- Main frame (window)
local frame = Instance.new("Frame")
frame.Name = "FollowFrame"
frame.Size = UDim2.new(0, 340, 0, 150)
frame.Position = UDim2.new(0.5, -170, 0.8, 0)
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
frame.BorderSizePixel = 0
frame.Parent = screenGui

-- Title bar (for dragging)
local titleBar = Instance.new("TextLabel")
titleBar.Size = UDim2.new(1, 0, 0, 30)
titleBar.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
titleBar.Text = "Player Spectate Window (Drag here)"
titleBar.TextColor3 = Color3.new(1, 1, 1)
titleBar.Font = Enum.Font.SourceSansBold
titleBar.TextSize = 18
titleBar.Parent = frame
titleBar.Active = true -- must be true to detect input
titleBar.Draggable = false -- we use custom dragging

-- Player info label
local playerInfo = Instance.new("TextLabel")
playerInfo.Name = "PlayerInfo"
playerInfo.Size = UDim2.new(1, -20, 0, 40)
playerInfo.Position = UDim2.new(0, 10, 0, 40)
playerInfo.BackgroundTransparency = 1
playerInfo.TextColor3 = Color3.new(1, 1, 1)
playerInfo.Font = Enum.Font.SourceSansBold
playerInfo.TextSize = 20
playerInfo.Text = "Loading players..."
playerInfo.TextWrapped = true
playerInfo.Parent = frame

-- Button helper function
local function createButton(name, text, posX, posY, width, height)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = UDim2.new(0, width or 60, 0, height or 40)
    btn.Position = UDim2.new(0, posX, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 20
    btn.Text = text
    btn.Parent = frame
    return btn
end

-- Buttons
local toggleBtn = createButton("ToggleBtn", "OFF", 10, 90, 60, 40)
local prevBtn = createButton("PrevBtn", "<", 80, 90, 50, 40)
local nextBtn = createButton("NextBtn", ">", 140, 90, 50, 40)
local firstPersonBtn = createButton("FirstPersonBtn", "1st Person", 200, 90, 120, 40)
local closeBtn = createButton("CloseBtn", "Close", 270, 10, 60, 20)

-- Variables
local playerList = {}
local currentIndex = 1
local followConnection = nil
local spectateOn = false
local spectateMode = "ThirdPerson" -- or "FirstPerson"

-- Update player list excluding local player
local function updatePlayerList()
    playerList = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            table.insert(playerList, player)
        end
    end
    if #playerList == 0 then
        currentIndex = 0
    elseif currentIndex > #playerList then
        currentIndex = 1
    end
end

local function updateLabel()
    if currentIndex == 0 or #playerList == 0 then
        playerInfo.Text = "No other players to follow."
        return
    end
    local targetPlayer = playerList[currentIndex]
    playerInfo.Text = string.format("Following: %s (%s) | Mode: %s", targetPlayer.Name, targetPlayer.DisplayName, spectateMode)
end

local function stopFollow()
    if followConnection then
        followConnection:Disconnect()
        followConnection = nil
    end
    Camera.CameraType = Enum.CameraType.Custom
end

local function followPlayer(player)
    stopFollow()
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
        playerInfo.Text = "Target player not loaded."
        return
    end

    followConnection = RunService.RenderStepped:Connect(function()
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = player.Character.HumanoidRootPart
            Camera.CameraType = Enum.CameraType.Scriptable
            if spectateMode == "ThirdPerson" then
                Camera.CFrame = hrp.CFrame * CFrame.new(0, 5, 10) * CFrame.Angles(math.rad(-20), math.rad(180), 0)
            elseif spectateMode == "FirstPerson" then
                local head = player.Character:FindFirstChild("Head")
                if head then
                    Camera.CFrame = head.CFrame * CFrame.new(0, 0, 0)
                else
                    Camera.CFrame = hrp.CFrame
                end
            end
        else
            stopFollow()
            playerInfo.Text = "Lost target player."
        end
    end)
end

local function cyclePlayer(direction)
    if #playerList == 0 then return end
    currentIndex = currentIndex + direction
    if currentIndex < 1 then
        currentIndex = #playerList
    elseif currentIndex > #playerList then
        currentIndex = 1
    end
    updateLabel()
    if spectateOn then
        followPlayer(playerList[currentIndex])
    end
end

local function toggleSpectate()
    spectateOn = not spectateOn
    toggleBtn.Text = spectateOn and "ON" or "OFF"
    if spectateOn then
        if currentIndex == 0 or #playerList == 0 then
            playerInfo.Text = "No other players to follow."
            return
        end
        updateLabel()
        followPlayer(playerList[currentIndex])
    else
        stopFollow()
        playerInfo.Text = "Spectate OFF"
    end
end

local function setSpectateMode(mode)
    spectateMode = mode
    if spectateOn and currentIndex > 0 and playerList[currentIndex] then
        updateLabel()
        followPlayer(playerList[currentIndex])
    end
end

local function closeGui()
    stopFollow()
    screenGui.Enabled = false
end

-- Custom draggable code for the title bar (dragging the window)
local dragging = false
local dragInput, mousePos, framePos

local function update(input)
    local delta = input.Position - mousePos
    frame.Position = UDim2.new(
        frame.Position.X.Scale,
        framePos.X + delta.X,
        frame.Position.Y.Scale,
        framePos.Y + delta.Y
    )
end

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        mousePos = input.Position
        framePos = frame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

titleBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        update(input)
    end
end)

-- Initial setup
updatePlayerList()
if #playerList > 0 then
    updateLabel()
else
    playerInfo.Text = "No other players to follow."
end

-- Connect buttons
toggleBtn.MouseButton1Click:Connect(toggleSpectate)
prevBtn.MouseButton1Click:Connect(function() cyclePlayer(-1) end)
nextBtn.MouseButton1Click:Connect(function() cyclePlayer(1) end)
firstPersonBtn.MouseButton1Click:Connect(function()
    setSpectateMode("FirstPerson")
end)
closeBtn.MouseButton1Click:Connect(closeGui)

-- Update player list dynamically
Players.PlayerAdded:Connect(function()
    updatePlayerList()
end)

Players.PlayerRemoving:Connect(function()
    updatePlayerList()
    if #playerList == 0 then
        currentIndex = 0
        playerInfo.Text = "No other players to follow."
        stopFollow()
        spectateOn = false
        toggleBtn.Text = "OFF"
    elseif currentIndex > #playerList then
        currentIndex = 1
        updateLabel()
        if spectateOn then
            followPlayer(playerList[currentIndex])
        end
    end
end)
