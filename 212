-- LocalScript: Camera Functions GUI (Safe Noclip Cam + Infinity Zoom)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Save original zoom
local originalMaxZoom = LocalPlayer.CameraMaxZoomDistance
local originalMinZoom = LocalPlayer.CameraMinZoomDistance

-- GUI
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "CameraFunctionsGUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local Frame = Instance.new("Frame")
Frame.Parent = ScreenGui
Frame.Size = UDim2.new(0, 250, 0, 170)
Frame.Position = UDim2.new(0.5, -125, 0.4, -85)
Frame.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
Frame.BorderSizePixel = 0
Frame.Active = true
Frame.Draggable = true

-- Title Bar
local TitleBar = Instance.new("Frame")
TitleBar.Parent = Frame
TitleBar.Size = UDim2.new(1, 0, 0, 35)
TitleBar.BackgroundColor3 = Color3.fromRGB(35, 35, 35)

local Title = Instance.new("TextLabel")
Title.Parent = TitleBar
Title.Size = UDim2.new(1, -40, 1, 0)
Title.Position = UDim2.new(0, 5, 0, 0)
Title.Text = "Camera Functions"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.Font = Enum.Font.SourceSansBold
Title.TextSize = 20
Title.BackgroundTransparency = 1

local CloseButton = Instance.new("TextButton")
CloseButton.Parent = TitleBar
CloseButton.Size = UDim2.new(0, 30, 0, 30)
CloseButton.Position = UDim2.new(1, -30, 0, 0)
CloseButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
CloseButton.TextColor3 = Color3.fromRGB(255, 255, 255)
CloseButton.Text = "X"
CloseButton.Font = Enum.Font.SourceSansBold
CloseButton.TextSize = 20
CloseButton.MouseButton1Click:Connect(function()
    ScreenGui:Destroy()
end)

-- Noclip Cam Toggle
local NoclipButton = Instance.new("TextButton")
NoclipButton.Parent = Frame
NoclipButton.Size = UDim2.new(0, 200, 0, 40)
NoclipButton.Position = UDim2.new(0.5, -100, 0.25, 0)
NoclipButton.Text = "Noclip Cam: OFF"
NoclipButton.Font = Enum.Font.SourceSansBold
NoclipButton.TextSize = 20
NoclipButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
NoclipButton.TextColor3 = Color3.fromRGB(0, 0, 0)

-- Infinity Zoom Toggle
local ZoomButton = Instance.new("TextButton")
ZoomButton.Parent = Frame
ZoomButton.Size = UDim2.new(0, 200, 0, 40)
ZoomButton.Position = UDim2.new(0.5, -100, 0.65, 0)
ZoomButton.Text = "Infinity Zoom: OFF"
ZoomButton.Font = Enum.Font.SourceSansBold
ZoomButton.TextSize = 20
ZoomButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
ZoomButton.TextColor3 = Color3.fromRGB(0, 0, 0)

-- Variables
local noclipCamEnabled = false
local zoomEnabled = false
local cameraSpeed = 1
local cameraCF = Camera.CFrame
local inputVector = Vector3.new(0,0,0)

-- Input tracking
local keys = {}
UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    keys[input.KeyCode] = true
end)
UIS.InputEnded:Connect(function(input)
    keys[input.KeyCode] = false
end)

-- Toggle Noclip Camera
NoclipButton.MouseButton1Click:Connect(function()
    noclipCamEnabled = not noclipCamEnabled
    NoclipButton.Text = noclipCamEnabled and "Noclip Cam: ON" or "Noclip Cam: OFF"
    if noclipCamEnabled then
        cameraCF = Camera.CFrame
        Camera.CameraType = Enum.CameraType.Scriptable
        UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
    else
        Camera.CameraType = Enum.CameraType.Custom
        UIS.MouseBehavior = Enum.MouseBehavior.Default
    end
end)

-- Toggle Infinity Zoom
ZoomButton.MouseButton1Click:Connect(function()
    zoomEnabled = not zoomEnabled
    ZoomButton.Text = zoomEnabled and "Infinity Zoom: ON" or "Infinity Zoom: OFF"
    if zoomEnabled then
        LocalPlayer.CameraMaxZoomDistance = math.huge
        LocalPlayer.CameraMinZoomDistance = 0
    else
        LocalPlayer.CameraMaxZoomDistance = originalMaxZoom
        LocalPlayer.CameraMinZoomDistance = originalMinZoom
    end
end)

-- Camera Update Loop
RunService.RenderStepped:Connect(function(delta)
    if noclipCamEnabled then
        local moveDir = Vector3.new()
        if keys[Enum.KeyCode.W] then moveDir = moveDir + Camera.CFrame.LookVector end
        if keys[Enum.KeyCode.S] then moveDir = moveDir - Camera.CFrame.LookVector end
        if keys[Enum.KeyCode.A] then moveDir = moveDir - Camera.CFrame.RightVector end
        if keys[Enum.KeyCode.D] then moveDir = moveDir + Camera.CFrame.RightVector end
        if keys[Enum.KeyCode.Space] then moveDir = moveDir + Vector3.new(0,1,0) end
        if keys[Enum.KeyCode.LeftShift] then moveDir = moveDir - Vector3.new(0,1,0) end

        moveDir = moveDir.Unit * cameraSpeed * delta
        if moveDir.Magnitude ~= moveDir.Magnitude then moveDir = Vector3.new(0,0,0) end
        cameraCF = cameraCF + moveDir

        -- Mouse rotation
        local deltaMouse = UIS:GetMouseDelta()
        local yaw = -deltaMouse.X * 0.002
        local pitch = -deltaMouse.Y * 0.002
        local rot = CFrame.Angles(pitch, yaw, 0)
        cameraCF = CFrame.new(cameraCF.Position) * CFrame.Angles(0,0,0) * CFrame.Angles(pitch, yaw, 0)
        Camera.CFrame = cameraCF
    end
end)
