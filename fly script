-- Fly logic (working version)
local flying = false
local flySpeed = 10
local bv, bg = nil, nil
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local movement = {
	F = 0,
	B = 0,
	L = 0,
	R = 0
}

local function updateSpeedLabel()
	speed.Text = "Speed: " .. flySpeed
end

local function startFlying()
	local char = player.Character or player.CharacterAdded:Wait()
	local hrp = char:WaitForChild("HumanoidRootPart")

	bv = Instance.new("BodyVelocity")
	bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
	bv.Velocity = Vector3.new(0, 0, 0)
	bv.Parent = hrp

	bg = Instance.new("BodyGyro")
	bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
	bg.CFrame = hrp.CFrame
	bg.Parent = hrp

	RunService:BindToRenderStep("FlyMovement", Enum.RenderPriority.Character.Value + 1, function()
		local camCF = workspace.CurrentCamera.CFrame
		local moveVec = Vector3.new(
			(movement.R - movement.L),
			0,
			(movement.B - movement.F)
		)

		moveVec = camCF:VectorToWorldSpace(moveVec)

		bv.Velocity = moveVec.Unit * flySpeed
		bg.CFrame = camCF
	end)
end

local function stopFlying()
	RunService:UnbindFromRenderStep("FlyMovement")
	if bv then bv:Destroy() bv = nil end
	if bg then bg:Destroy() bg = nil end
end

onoff.Text = "FLY ON"

onoff.MouseButton1Click:Connect(function()
	flying = not flying
	if flying then
		onoff.Text = "FLY OFF"
		startFlying()
	else
		onoff.Text = "FLY ON"
		stopFlying()
	end
end)

plus.MouseButton1Click:Connect(function()
	flySpeed = flySpeed + 1
	updateSpeedLabel()
end)

mine.MouseButton1Click:Connect(function()
	if flySpeed > 1 then
		flySpeed = flySpeed - 1
		updateSpeedLabel()
	end
end)

-- WASD movement binding
UIS.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Keyboard then
		if input.KeyCode == Enum.KeyCode.W then movement.F = 1 end
		if input.KeyCode == Enum.KeyCode.S then movement.B = 1 end
		if input.KeyCode == Enum.KeyCode.A then movement.L = 1 end
		if input.KeyCode == Enum.KeyCode.D then movement.R = 1 end
	end
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Keyboard then
		if input.KeyCode == Enum.KeyCode.W then movement.F = 0 end
		if input.KeyCode == Enum.KeyCode.S then movement.B = 0 end
		if input.KeyCode == Enum.KeyCode.A then movement.L = 0 end
		if input.KeyCode == Enum.KeyCode.D then movement.R = 0 end
	end
end)

updateSpeedLabel()
