-- Drag функціонал
local UIS = game:GetService("UserInputService")
local dragging, dragStart, startPos

title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Закриття меню
closeBtn.MouseButton1Click:Connect(function()
    gui:Destroy()
end)

-- Fly змінні
local flying = false
local speed = tonumber(speedBox.Text) or 50
local char = player.Character or player.CharacterAdded:Wait()
local hrp = char:WaitForChild("HumanoidRootPart")
local hum = char:WaitForChild("Humanoid")
local cam = workspace.CurrentCamera
local flyConn

-- Оновити швидкість при вводі вручну
speedBox.FocusLost:Connect(function()
	local num = tonumber(speedBox.Text)
	if num then
		speed = num
	end
end)

-- Зменшити швидкість
minusBtn.MouseButton1Click:Connect(function()
	speed = math.max(0, speed - 10)
	speedBox.Text = tostring(speed)
end)

-- Збільшити швидкість
plusBtn.MouseButton1Click:Connect(function()
	speed = speed + 10
	speedBox.Text = tostring(speed)
end)

-- Почати політ (миттєвий рух)
flyBtn.MouseButton1Click:Connect(function()
	if flying then return end
	flying = true
	hum.PlatformStand = true

	flyConn = game:GetService("RunService").RenderStepped:Connect(function(dt)
		local move = Vector3.new()
		if UIS:IsKeyDown(Enum.KeyCode.W) then move = move + cam.CFrame.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.S) then move = move - cam.CFrame.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.A) then move = move - cam.CFrame.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.D) then move = move + cam.CFrame.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.E) then move = move + Vector3.new(0, 1, 0) end
		if UIS:IsKeyDown(Enum.KeyCode.R) then move = move - Vector3.new(0, 1, 0) end

		if move.Magnitude > 0 then
			hrp.CFrame = hrp.CFrame + (move.Unit * speed * dt)
		end
	end)
end)

-- Зупинити політ
stopBtn.MouseButton1Click:Connect(function()
	flying = false
	if flyConn then flyConn:Disconnect() end
	hum.PlatformStand = false
end)
