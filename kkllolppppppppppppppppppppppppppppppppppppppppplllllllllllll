-- ESP Variables
local espEnabled = false
local espObjects = {}

-- Function to create Bone-like ESP (Skeleton)
local function createSkeletonESP(player)
    -- Create a table to store lines for each body part
    local espLines = {}

    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end

    -- Create line from HumanoidRootPart to Torso
    local function createLine(startPart, endPart)
        local line = Instance.new("Part")
        line.Size = Vector3.new(0.1, 0.1, (startPart.Position - endPart.Position).Magnitude)
        line.Anchored = true
        line.CanCollide = false
        line.Transparency = 0.6
        line.Color = player.TeamColor.Color
        line.Parent = espGui

        -- Orient the line to connect the two parts
        local direction = (endPart.Position - startPart.Position).unit
        line.CFrame = CFrame.new(startPart.Position, endPart.Position) * CFrame.new(0, 0, -line.Size.Z / 2)

        table.insert(espLines, line)
    end

    -- Create skeleton lines for key body parts
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        local rootPart = character.HumanoidRootPart
        local head = character:FindFirstChild("Head")
        local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
        local leftLeg = character:FindFirstChild("LeftLeg")
        local rightLeg = character:FindFirstChild("RightLeg")
        local leftArm = character:FindFirstChild("LeftUpperArm")
        local rightArm = character:FindFirstChild("RightUpperArm")

        -- Connect body parts with lines (bones)
        if head and torso then createLine(head, torso) end
        if torso and rootPart then createLine(torso, rootPart) end
        if leftLeg and rootPart then createLine(leftLeg, rootPart) end
        if rightLeg and rootPart then createLine(rightLeg, rootPart) end
        if leftArm and rootPart then createLine(leftArm, rootPart) end
        if rightArm and rootPart then createLine(rightArm, rootPart) end
    end

    espObjects[player] = espLines
end

-- Function to remove the skeleton ESP
local function removeSkeletonESP(player)
    if espObjects[player] then
        for _, line in pairs(espObjects[player]) do
            line:Destroy()
        end
        espObjects[player] = nil
    end
end

-- Toggle ESP On
toggleOnButton.MouseButton1Click:Connect(function()
    espEnabled = true
    -- Create ESP for all players
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= Players.LocalPlayer then
            createSkeletonESP(player)
        end
    end
end)

-- Toggle ESP Off
toggleOffButton.MouseButton1Click:Connect(function()
    espEnabled = false
    -- Remove ESP from all players
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= Players.LocalPlayer then
            removeSkeletonESP(player)
        end
    end
end)

-- Close the GUI
closeButton.MouseButton1Click:Connect(function()
    espEnabled = false
    -- Remove ESP when the window is closed
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= Players.LocalPlayer then
            removeSkeletonESP(player)
        end
    end
    espGui:Destroy()
end)

-- Create ESP for new players joining
Players.PlayerAdded:Connect(function(player)
    if espEnabled then
        createSkeletonESP(player)
    end
end)

-- Remove ESP when players leave
Players.PlayerRemoving:Connect(function(player)
    removeSkeletonESP(player)
end)

-- Initial ESP setup for players already in the game
for _, player in pairs(Players:GetPlayers()) do
    if player ~= Players.LocalPlayer then
        createSkeletonESP(player)
    end
end

