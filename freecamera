-- MOUSE LOOK FIXED:

local mouseLookEnabled = false
local lastMousePos = nil
local sensitivity = 0.2

UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if freecamEnabled and input.UserInputType == Enum.UserInputType.MouseButton2 then
        mouseLookEnabled = true
        lastMousePos = UIS:GetMouseLocation()
        -- Lock mouse so it doesn't leave window
        UIS.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
    end
end)

UIS.InputEnded:Connect(function(input, gameProcessed)
    if freecamEnabled and input.UserInputType == Enum.UserInputType.MouseButton2 then
        mouseLookEnabled = false
        -- Restore normal mouse behavior
        UIS.MouseBehavior = Enum.MouseBehavior.Default
    end
end)

UIS.InputChanged:Connect(function(input, gameProcessed)
    if freecamEnabled and mouseLookEnabled and input.UserInputType == Enum.UserInputType.MouseMovement then
        local currentPos = input.Position
        local delta = currentPos - lastMousePos
        lastMousePos = currentPos

        cameraYaw = cameraYaw - delta.X * sensitivity
        cameraPitch = math.clamp(cameraPitch - delta.Y * sensitivity, -89, 89)
    end
end)

