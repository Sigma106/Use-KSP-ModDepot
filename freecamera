-- Dragging logic for header
local dragging, dragInput, dragStart, startPos
header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)
header.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        dragInput = input
    end
end)
UIS.InputChanged:Connect(function(input)
    if dragging and input == dragInput then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
                                   startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Speed change handlers
minusBtn.MouseButton1Click:Connect(function()
    speed = math.max(0.1, speed - 0.5)
    speedLabel.Text = "Speed: "..string.format("%.1f", speed)
end)

plusBtn.MouseButton1Click:Connect(function()
    speed = speed + 0.5
    speedLabel.Text = "Speed: "..string.format("%.1f", speed)
end)

-- Movement keys tracking
local moveForward, moveBackward, moveLeft, moveRight, moveUp, moveDown = false, false, false, false, false, false

UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if freecamEnabled then
        if input.KeyCode == Enum.KeyCode.W or input.KeyCode == Enum.KeyCode.Up then
            moveForward = true
        elseif input.KeyCode == Enum.KeyCode.S or input.KeyCode == Enum.KeyCode.Down then
            moveBackward = true
        elseif input.KeyCode == Enum.KeyCode.A or input.KeyCode == Enum.KeyCode.Left then
            moveLeft = true
        elseif input.KeyCode == Enum.KeyCode.D or input.KeyCode == Enum.KeyCode.Right then
            moveRight = true
        elseif input.KeyCode == Enum.KeyCode.E then
            moveUp = true
        elseif input.KeyCode == Enum.KeyCode.Q then
            moveDown = true
        end
    end
end)

UIS.InputEnded:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if freecamEnabled then
        if input.KeyCode == Enum.KeyCode.W or input.KeyCode == Enum.KeyCode.Up then
            moveForward = false
        elseif input.KeyCode == Enum.KeyCode.S or input.KeyCode == Enum.KeyCode.Down then
            moveBackward = false
        elseif input.KeyCode == Enum.KeyCode.A or input.KeyCode == Enum.KeyCode.Left then
            moveLeft = false
        elseif input.KeyCode == Enum.KeyCode.D or input.KeyCode == Enum.KeyCode.Right then
            moveRight = false
        elseif input.KeyCode == Enum.KeyCode.E then
            moveUp = false
        elseif input.KeyCode == Enum.KeyCode.Q then
            moveDown = false
        end
    end
end)

-- Toggle freecam logic
toggleBtn.MouseButton1Click:Connect(function()
    freecamEnabled = not freecamEnabled
    if freecamEnabled then
        Camera.CameraType = Enum.CameraType.Scriptable
        print("[Freecam] Enabled")
    else
        Camera.CameraType = Enum.CameraType.Custom
        print("[Freecam] Disabled")
    end
end)

-- Store original camera CFrame so we can reset if needed
local originalCFrame = Camera.CFrame

-- Run loop for moving freecam
RunService.RenderStepped:Connect(function(deltaTime)
    if freecamEnabled then
        local camCF = Camera.CFrame
        local moveDir = Vector3.new(0,0,0)

        if moveForward then
            moveDir = moveDir + camCF.LookVector
        end
        if moveBackward then
            moveDir = moveDir - camCF.LookVector
        end
        if moveLeft then
            moveDir = moveDir - camCF.RightVector
        end
        if moveRight then
            moveDir = moveDir + camCF.RightVector
        end
        if moveUp then
            moveDir = moveDir + Vector3.new(0,1,0)
        end
        if moveDown then
            moveDir = moveDir - Vector3.new(0,1,0)
        end

        if moveDir.Magnitude > 0 then
            moveDir = moveDir.Unit
            Camera.CFrame = camCF + moveDir * speed
        end
    end
end)
