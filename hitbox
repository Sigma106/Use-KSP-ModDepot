-- Simple ESP GUI (LocalScript)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- SETTINGS
local Settings = {
	Enabled = true,
	Size = 50,
	ThroughWalls = true,
	Color = Color3.fromRGB(0, 170, 255)
}

-- GUI
local gui = Instance.new("ScreenGui", game.CoreGui)
gui.Name = "SimpleESP"

local main = Instance.new("Frame", gui)
main.Size = UDim2.new(0, 300, 0, 220)
main.Position = UDim2.new(0.5, -150, 0.5, -110)
main.BackgroundColor3 = Color3.fromRGB(25,25,25)
main.Active = true
main.Draggable = true

-- Title
local title = Instance.new("TextLabel", main)
title.Size = UDim2.new(1, -40, 0, 30)
title.Text = "ESP Settings"
title.TextColor3 = Color3.new(1,1,1)
title.BackgroundTransparency = 1
title.TextXAlignment = Enum.TextXAlignment.Left
title.Position = UDim2.new(0, 10, 0, 0)

-- Close
local close = Instance.new("TextButton", main)
close.Size = UDim2.new(0, 30, 0, 30)
close.Position = UDim2.new(1, -30, 0, 0)
close.Text = "X"
close.BackgroundColor3 = Color3.fromRGB(60,60,60)
close.TextColor3 = Color3.new(1,1,1)
close.MouseButton1Click:Connect(function()
	gui:Destroy()
end)

-- Toggle function
local function toggle(text, y, callback)
	local btn = Instance.new("TextButton", main)
	btn.Size = UDim2.new(1, -20, 0, 28)
	btn.Position = UDim2.new(0, 10, 0, y)
	btn.BackgroundColor3 = Color3.fromRGB(35,35,35)
	btn.TextColor3 = Color3.new(1,1,1)

	btn.MouseButton1Click:Connect(function()
		callback(btn)
	end)

	return btn
end

-- Enabled toggle
local enableBtn = toggle("ESP: ON", 40, function(b)
	Settings.Enabled = not Settings.Enabled
	b.Text = "ESP: " .. (Settings.Enabled and "ON" or "OFF")
end)

-- Through walls toggle
local wallBtn = toggle("Through Walls: ON", 75, function(b)
	Settings.ThroughWalls = not Settings.ThroughWalls
	b.Text = "Through Walls: " .. (Settings.ThroughWalls and "ON" or "OFF")
end)

-- SIZE SLIDER
local sizeLabel = Instance.new("TextLabel", main)
sizeLabel.Position = UDim2.new(0,10,0,115)
sizeLabel.Size = UDim2.new(1,-20,0,20)
sizeLabel.Text = "Size: 50"
sizeLabel.TextColor3 = Color3.new(1,1,1)
sizeLabel.BackgroundTransparency = 1

local slider = Instance.new("Frame", main)
slider.Position = UDim2.new(0,10,0,140)
slider.Size = UDim2.new(1,-20,0,6)
slider.BackgroundColor3 = Color3.fromRGB(60,60,60)

local fill = Instance.new("Frame", slider)
fill.Size = UDim2.new(0.5,0,1,0)
fill.BackgroundColor3 = Color3.fromRGB(120,120,120)

local dragging = false
slider.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
	end
end)

slider.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

RunService.RenderStepped:Connect(function()
	if dragging then
		local mouse = game.Players.LocalPlayer:GetMouse()
		local scale = math.clamp((mouse.X - slider.AbsolutePosition.X) / slider.AbsoluteSize.X, 0, 1)
		fill.Size = UDim2.new(scale,0,1,0)
		Settings.Size = math.floor(5 + scale * 95)
		sizeLabel.Text = "Size: "..Settings.Size
	end
end)

-- COLOR TEXTBOX (R,G,B)
local colorBox = Instance.new("TextBox", main)
colorBox.Position = UDim2.new(0,10,0,165)
colorBox.Size = UDim2.new(1,-20,0,30)
colorBox.PlaceholderText = "Color RGB (e.g. 0,170,255)"
colorBox.TextColor3 = Color3.new(1,1,1)
colorBox.BackgroundColor3 = Color3.fromRGB(35,35,35)

colorBox.FocusLost:Connect(function()
	local r,g,b = colorBox.Text:match("(%d+),(%d+),(%d+)")
	if r and g and b then
		Settings.Color = Color3.fromRGB(tonumber(r),tonumber(g),tonumber(b))
	end
end)

-- ESP LOOP
RunService.RenderStepped:Connect(function()
	if not Settings.Enabled then return end

	for _,plr in pairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
			local hrp = plr.Character.HumanoidRootPart
			hrp.Size = Vector3.new(Settings.Size, Settings.Size, Settings.Size)
			hrp.Color = Settings.Color
			hrp.Material = Enum.Material.Neon
			hrp.Transparency = Settings.ThroughWalls and 0.5 or 0
			hrp.CanCollide = not Settings.ThroughWalls
		end
	end
end)
