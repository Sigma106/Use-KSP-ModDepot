-- Visible Hitbox Changer with HEX Color (LocalScript)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- SETTINGS
local HitboxEnabled = false -- default OFF
local HitboxSize = 10
local HitboxTransparency = 0.5
local HitboxColor = Color3.fromRGB(255, 0, 0)

-- GUI
local gui = Instance.new("ScreenGui", game.CoreGui)
gui.Name = "HitboxGUI"

local main = Instance.new("Frame", gui)
main.Size = UDim2.new(0, 260, 0, 220)
main.Position = UDim2.new(0.5, -130, 0.5, -110)
main.BackgroundColor3 = Color3.fromRGB(30,30,30)
main.Active = true
main.Draggable = true

-- Title
local title = Instance.new("TextLabel", main)
title.Size = UDim2.new(1, -40, 0, 30)
title.Position = UDim2.new(0, 10, 0, 0)
title.Text = "Hitbox Settings"
title.TextColor3 = Color3.new(1,1,1)
title.BackgroundTransparency = 1
title.TextXAlignment = Enum.TextXAlignment.Left

-- Close
local close = Instance.new("TextButton", main)
close.Size = UDim2.new(0, 30, 0, 30)
close.Position = UDim2.new(1, -30, 0, 0)
close.Text = "X"
close.TextColor3 = Color3.new(1,1,1)
close.BackgroundColor3 = Color3.fromRGB(60,60,60)

close.MouseButton1Click:Connect(function()
	gui:Destroy()
end)

-- Toggle button
local toggle = Instance.new("TextButton", main)
toggle.Size = UDim2.new(1, -20, 0, 30)
toggle.Position = UDim2.new(0, 10, 0, 40)
toggle.BackgroundColor3 = Color3.fromRGB(40,40,40)
toggle.TextColor3 = Color3.new(1,1,1)
toggle.Text = "Hitbox: OFF"

toggle.MouseButton1Click:Connect(function()
	HitboxEnabled = not HitboxEnabled
	toggle.Text = "Hitbox: " .. (HitboxEnabled and "ON" or "OFF")
end)

-- Size TextBox
local sizeBox = Instance.new("TextBox", main)
sizeBox.Size = UDim2.new(1, -20, 0, 30)
sizeBox.Position = UDim2.new(0, 10, 0, 80)
sizeBox.BackgroundColor3 = Color3.fromRGB(40,40,40)
sizeBox.TextColor3 = Color3.new(1,1,1)
sizeBox.PlaceholderText = "Hitbox Size (ex: 10)"
sizeBox.Text = tostring(HitboxSize)

sizeBox.FocusLost:Connect(function()
	local num = tonumber(sizeBox.Text)
	if num and num >= 2 and num <= 100 then
		HitboxSize = num
	else
		sizeBox.Text = tostring(HitboxSize)
	end
end)

-- HEX Color TextBox
local colorBox = Instance.new("TextBox", main)
colorBox.Size = UDim2.new(1, -20, 0, 30)
colorBox.Position = UDim2.new(0, 10, 0, 120)
colorBox.BackgroundColor3 = Color3.fromRGB(40,40,40)
colorBox.TextColor3 = Color3.new(1,1,1)
colorBox.PlaceholderText = "HEX Color (ex: #822817)"
colorBox.Text = "#FF0000"

-- Apply Color Button
local applyColor = Instance.new("TextButton", main)
applyColor.Size = UDim2.new(1, -20, 0, 30)
applyColor.Position = UDim2.new(0, 10, 0, 160)
applyColor.BackgroundColor3 = Color3.fromRGB(50,50,50)
applyColor.TextColor3 = Color3.new(1,1,1)
applyColor.Text = "Apply Color"

-- HEX → Color3
local function hexToColor3(hex)
	hex = hex:gsub("#","")
	if #hex ~= 6 then return end

	local r = tonumber(hex:sub(1,2),16)
	local g = tonumber(hex:sub(3,4),16)
	local b = tonumber(hex:sub(5,6),16)

	if r and g and b then
		return Color3.fromRGB(r,g,b)
	end
end

applyColor.MouseButton1Click:Connect(function()
	local color = hexToColor3(colorBox.Text)
	if color then
		HitboxColor = color
	end
end)

-- HITBOX LOGIC
RunService.RenderStepped:Connect(function()
	for _,plr in pairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer
			and plr.Character
			and plr.Character:FindFirstChild("HumanoidRootPart") then

			local hrp = plr.Character.HumanoidRootPart

			if HitboxEnabled then
				hrp.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
				hrp.Transparency = HitboxTransparency
				hrp.Material = Enum.Material.ForceField
				hrp.Color = HitboxColor
				hrp.CanCollide = false
			else
				hrp.Size = Vector3.new(2,2,1)
				hrp.Transparency = 1
				hrp.Material = Enum.Material.Plastic
				hrp.Color = Color3.new(1,1,1)
				hrp.CanCollide = true
			end
		end
	end
end)
