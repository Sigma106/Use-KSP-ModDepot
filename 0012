--// Scrollable Script Executor GUI

local Player = game.Players.LocalPlayer
local UIS = game:GetService("UserInputService")

-- ScreenGui
local gui = Instance.new("ScreenGui")
gui.Name = "ExecutorGui"
gui.ResetOnSpawn = false
gui.Parent = Player:WaitForChild("PlayerGui")

-- Main Frame
local main = Instance.new("Frame")
main.Parent = gui
main.Size = UDim2.new(0, 500, 0, 350)
main.Position = UDim2.new(0.3, 0, 0.2, 0)
main.BackgroundColor3 = Color3.fromRGB(35,35,35)
main.BorderSizePixel = 0

Instance.new("UICorner", main).CornerRadius = UDim.new(0,10)

-- Top Bar
local top = Instance.new("Frame")
top.Parent = main
top.Size = UDim2.new(1, 0, 0, 30)
top.BackgroundColor3 = Color3.fromRGB(25,25,25)
top.BorderSizePixel = 0

-- Title
local title = Instance.new("TextLabel")
title.Parent = top
title.Size = UDim2.new(1,-40,1,0)
title.Position = UDim2.new(0,10,0,0)
title.Text = "Script Executor"
title.TextColor3 = Color3.new(1,1,1)
title.BackgroundTransparency = 1
title.TextXAlignment = Enum.TextXAlignment.Left
title.Font = Enum.Font.GothamBold
title.TextSize = 14

-- Close Button
local close = Instance.new("TextButton")
close.Parent = top
close.Size = UDim2.new(0,30,1,0)
close.Position = UDim2.new(1,-30,0,0)
close.Text = "X"
close.TextColor3 = Color3.fromRGB(255,80,80)
close.BackgroundTransparency = 1
close.Font = Enum.Font.GothamBold
close.TextSize = 14
close.MouseButton1Click:Connect(function()
	gui:Destroy()
end)

-- Scrolling Frame for TextBox
local scrollFrame = Instance.new("ScrollingFrame")
scrollFrame.Parent = main
scrollFrame.Position = UDim2.new(0,10,0,40)
scrollFrame.Size = UDim2.new(1,-20,1,-100)
scrollFrame.BackgroundColor3 = Color3.fromRGB(45,45,45)
scrollFrame.BorderSizePixel = 0
scrollFrame.CanvasSize = UDim2.new(0,0,2,0) -- make scrollable
scrollFrame.ScrollBarThickness = 8

Instance.new("UICorner", scrollFrame).CornerRadius = UDim.new(0,6)

-- Script TextBox inside scrolling frame
local box = Instance.new("TextBox")
box.Parent = scrollFrame
box.Size = UDim2.new(1,-10,2,0) -- height larger than scrollFrame for scrolling
box.Position = UDim2.new(0,5,0,0)
box.BackgroundTransparency = 1
box.TextColor3 = Color3.new(1,1,1)
box.Font = Enum.Font.Code
box.TextSize = 14
box.MultiLine = true
box.TextWrapped = false
box.ClearTextOnFocus = false
box.TextXAlignment = Enum.TextXAlignment.Left
box.TextYAlignment = Enum.TextYAlignment.Top
box.Text = [[-- Paste your script here

loadstring(game:HttpGet("https://raw.githubusercontent.com/Sigma106/Use-KSP-ModDepot/refs/heads/main/2001", true))()
]]

-- Execute Button
local execute = Instance.new("TextButton")
execute.Parent = main
execute.Size = UDim2.new(0,120,0,35)
execute.Position = UDim2.new(0.5,-60,1,-45)
execute.BackgroundColor3 = Color3.fromRGB(0,120,255)
execute.Text = "EXECUTE"
execute.TextColor3 = Color3.new(1,1,1)
execute.Font = Enum.Font.GothamBold
execute.TextSize = 14

execute.MouseButton1Click:Connect(function()
	local source = box.Text
	local func, err = loadstring(source)
	if func then
		pcall(func)
	else
		warn("Loadstring error:", err)
	end
end)

-- DRAGGING
local dragging = false
local dragStart
local startPos

top.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = main.Position
	end
end)

UIS.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		main.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)
