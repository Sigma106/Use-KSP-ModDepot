-- Hitbox GUI (SOLID at Transparency 0)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- SETTINGS
local HitboxEnabled = false
local HitboxSize = 10
local HitboxColor = Color3.fromRGB(255, 0, 0)
local HitboxTransparency = 0

-- GUI
local gui = Instance.new("ScreenGui", game.CoreGui)
gui.Name = "HitboxGUI"

local main = Instance.new("Frame", gui)
main.Size = UDim2.new(0, 280, 0, 320)
main.Position = UDim2.new(0.5, -140, 0.5, -160)
main.BackgroundColor3 = Color3.fromRGB(30,30,30)
main.Active = true
main.Draggable = true

-- Title
local title = Instance.new("TextLabel", main)
title.Size = UDim2.new(1, -40, 0, 30)
title.Position = UDim2.new(0, 10, 0, 0)
title.Text = "Hitbox Settings"
title.TextColor3 = Color3.new(1,1,1)
title.BackgroundTransparency = 1
title.TextXAlignment = Enum.TextXAlignment.Left

-- Close
local close = Instance.new("TextButton", main)
close.Size = UDim2.new(0, 30, 0, 30)
close.Position = UDim2.new(1, -30, 0, 0)
close.Text = "X"
close.TextColor3 = Color3.new(1,1,1)
close.BackgroundColor3 = Color3.fromRGB(60,60,60)
close.MouseButton1Click:Connect(function()
	gui:Destroy()
end)

-- Status
local statusLabel = Instance.new("TextLabel", main)
statusLabel.Size = UDim2.new(1, -20, 0, 20)
statusLabel.Position = UDim2.new(0, 10, 0, 40)
statusLabel.Text = "Hitbox: OFF"
statusLabel.TextColor3 = Color3.new(1,1,1)
statusLabel.BackgroundTransparency = 1
statusLabel.TextXAlignment = Enum.TextXAlignment.Left

-- Toggle
local toggle = Instance.new("TextButton", main)
toggle.Size = UDim2.new(1, -20, 0, 30)
toggle.Position = UDim2.new(0, 10, 0, 65)
toggle.Text = "Toggle Hitbox"
toggle.BackgroundColor3 = Color3.fromRGB(40,40,40)
toggle.TextColor3 = Color3.new(1,1,1)

toggle.MouseButton1Click:Connect(function()
	HitboxEnabled = not HitboxEnabled
	statusLabel.Text = "Hitbox: " .. (HitboxEnabled and "ON" or "OFF")
end)

-- Size
local sizeBox = Instance.new("TextBox", main)
sizeBox.Size = UDim2.new(1, -20, 0, 30)
sizeBox.Position = UDim2.new(0, 10, 0, 125)
sizeBox.Text = tostring(HitboxSize)
sizeBox.PlaceholderText = "Hitbox Size"
sizeBox.BackgroundColor3 = Color3.fromRGB(40,40,40)
sizeBox.TextColor3 = Color3.new(1,1,1)

sizeBox.FocusLost:Connect(function()
	local n = tonumber(sizeBox.Text)
	if n and n >= 2 and n <= 100 then
		HitboxSize = n
	else
		sizeBox.Text = tostring(HitboxSize)
	end
end)

-- Color
local colorBox = Instance.new("TextBox", main)
colorBox.Size = UDim2.new(1, -20, 0, 30)
colorBox.Position = UDim2.new(0, 10, 0, 185)
colorBox.Text = "#FF0000"
colorBox.PlaceholderText = "HEX Color"
colorBox.BackgroundColor3 = Color3.fromRGB(40,40,40)
colorBox.TextColor3 = Color3.new(1,1,1)

-- Transparency
local transBox = Instance.new("TextBox", main)
transBox.Size = UDim2.new(1, -20, 0, 30)
transBox.Position = UDim2.new(0, 10, 0, 245)
transBox.Text = tostring(HitboxTransparency)
transBox.PlaceholderText = "Transparency (0 - 1)"
transBox.BackgroundColor3 = Color3.fromRGB(40,40,40)
transBox.TextColor3 = Color3.new(1,1,1)

-- Apply
local apply = Instance.new("TextButton", main)
apply.Size = UDim2.new(1, -20, 0, 30)
apply.Position = UDim2.new(0, 10, 0, 280)
apply.Text = "Apply"
apply.BackgroundColor3 = Color3.fromRGB(50,50,50)
apply.TextColor3 = Color3.new(1,1,1)

local function hexToColor3(hex)
	hex = hex:gsub("#","")
	if #hex ~= 6 then return end
	return Color3.fromRGB(
		tonumber(hex:sub(1,2),16),
		tonumber(hex:sub(3,4),16),
		tonumber(hex:sub(5,6),16)
	)
end

apply.MouseButton1Click:Connect(function()
	local c = hexToColor3(colorBox.Text)
	if c then HitboxColor = c end

	local t = tonumber(transBox.Text)
	if t then HitboxTransparency = math.clamp(t, 0, 1) end
end)

-- HITBOX LOOP
RunService.RenderStepped:Connect(function()
	for _,plr in pairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
			local hrp = plr.Character.HumanoidRootPart

			if HitboxEnabled then
				hrp.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
				hrp.Material = Enum.Material.Plastic -- 🔥 FIX
				hrp.Color = HitboxColor
				hrp.Transparency = HitboxTransparency
				hrp.CanCollide = false
			else
				hrp.Size = Vector3.new(2,2,1)
				hrp.Material = Enum.Material.Plastic
				hrp.Transparency = 1
				hrp.CanCollide = true
			end
		end
	end
end)
