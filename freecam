-- Variables
local selectedPlayer = nil

-- Function to update player list
local function UpdatePlayerList()
	PlayerList:ClearAllChildren()
	selectedPlayer = nil
	local players = Players:GetPlayers()
	CountLabel.Text = "Players: " .. tostring(#players)

	for _, player in ipairs(players) do
		if player ~= LocalPlayer then
			local Button = Instance.new("TextButton")
			Button.Size = UDim2.new(1, 0, 0, 30)
			Button.Text = player.Name
			Button.TextColor3 = Color3.fromRGB(255, 255, 255)
			Button.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
			Button.Font = Enum.Font.SourceSans
			Button.TextSize = 14
			Button.Parent = PlayerList

			Button.MouseButton1Click:Connect(function()
				for _, other in ipairs(PlayerList:GetChildren()) do
					if other:IsA("TextButton") then
						other.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
					end
				end
				Button.BackgroundColor3 = Color3.fromRGB(100, 100, 150)
				selectedPlayer = player
			end)
		end
	end

	-- Adjust Canvas Size
	task.wait()
	PlayerList.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y)
end

-- Teleport function
TeleportButton.MouseButton1Click:Connect(function()
	if selectedPlayer and selectedPlayer.Character and selectedPlayer.Character:FindFirstChild("HumanoidRootPart") then
		local root = selectedPlayer.Character.HumanoidRootPart
		local myChar = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
		local myRoot = myChar:WaitForChild("HumanoidRootPart")
		myRoot.CFrame = root.CFrame + Vector3.new(2, 0, 0) -- Slight offset to avoid collision
	end
end)

-- Close Button Functionality
CloseButton.MouseButton1Click:Connect(function()
	ScreenGui.Enabled = false
end)

-- Player join/leave detection
Players.PlayerAdded:Connect(UpdatePlayerList)
Players.PlayerRemoving:Connect(UpdatePlayerList)

-- Initial List Update
UpdatePlayerList()
