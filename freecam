-- Function to update the GUI with player info by username
local function updatePlayerInfo(username)
    -- Try find player locally first
    local target = Players:FindFirstChild(username)

    -- If player not found locally, try Roblox API for userId & avatar (optional)
    if not target then
        -- We can’t get nickname directly if player offline
        -- Just show username and placeholder avatar in this case
        avatarImage.Image = "rbxasset://textures/ui/GuiImagePlaceholder.png"
        displayNameLabel.Text = "Player not found"
        usernameLabel.Text = username
        return
    end

    -- Update display name and username
    displayNameLabel.Text = target.DisplayName
    usernameLabel.Text = "@" .. target.Name

    -- Set avatar image using Roblox thumbnail API
    local userId = target.UserId
    local thumbUrl = Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
    avatarImage.Image = thumbUrl
end

inputBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local text = inputBox.Text:match("^%s*(.-)%s*$") -- trim spaces
        if text ~= "" then
            updatePlayerInfo(text)
        end
    end
end)
