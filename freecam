-- Load Rayfield
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- Create Window
local Window = Rayfield:CreateWindow({
  Name = "Teleport GUI",
  LoadingTitle = "Teleport Interface",
  LoadingSubtitle = "Select & Teleport",
  ConfigurationSaving = { Enabled = false },
  Discord = { Enabled = false },
  KeySystem = false
})

-- Create Tab and Section
local TeleportTab = Window:CreateTab("Teleport")
local TPSection = TeleportTab:CreateSection("Player Teleport")

-- Helper to get player list strings
local function getPlayerStrings()
  local list = {}
  for _, plr in ipairs(game.Players:GetPlayers()) do
    if plr ~= game.Players.LocalPlayer then
      table.insert(list, plr.DisplayName .. " [@" .. plr.Name .. "]")
    end
  end
  return list
end

-- Create Dropdown
local PlayerDropdown = TPSection:CreateDropdown({
  Name = "Select Player",
  Options = getPlayerStrings(),
  CurrentOption = {},  -- start with none selected
  MultipleOptions = false,
  Flag = "PlayerDropdown",
  Callback = function(option)
    -- Option is a table, e.g. {"Nick [@username]"}
    print("Selected:", option[1])
  end
})

-- Teleport Button
TPSection:CreateButton({
  Name = "Teleport",
  Callback = function()
    local selected = PlayerDropdown.CurrentOption[1]
    if not selected then
      Rayfield:Notify({Title = "Error", Content = "No player selected", Duration = 2})
      return
    end

    local username = selected:match("%[@(.-)%]")
    local target = game.Players:FindFirstChild(username)
    if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
      local myHRP = game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
      if myHRP then
        myHRP.CFrame = target.Character.HumanoidRootPart.CFrame + Vector3.new(2,0,0)
        Rayfield:Notify({Title = "Teleported", Content = "To " .. selected, Duration = 2})
      end
    else
      Rayfield:Notify({Title = "Failed", Content = "Player not found or not loaded", Duration = 2})
    end
  end
})

-- Update dropdown on player join/leave
game.Players.PlayerAdded:Connect(function()
  PlayerDropdown:Set({})
  PlayerDropdown:Set(getPlayerStrings())
  PlayerDropdown:Refresh(getPlayerStrings())
end)

game.Players.PlayerRemoving:Connect(function()
  PlayerDropdown:Set({})
  PlayerDropdown:Set(getPlayerStrings())
  PlayerDropdown:Refresh(getPlayerStrings())
end)
