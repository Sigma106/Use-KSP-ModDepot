-- GUI to Lua
-- Version: 2.0.

-- Instances:

local SpectateGui = Instance.new("ScreenGui")
local Button = Instance.new("ImageButton")
local Bar = Instance.new("Frame")
local Title = Instance.new("TextLabel")
local Next = Instance.new("TextButton")
local Previous = Instance.new("TextButton")
local Close = Instance.new("TextButton")
local UIGradient = Instance.new("UIGradient")
local UIGradient_2 = Instance.new("UIGradient")
local UIGradient_3 = Instance.new("UIGradient")

-- Properties:

SpectateGui.Name = "SpectateGui"
SpectateGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")

Button.Name = "Button"
Button.Parent = SpectateGui
Button.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
Button.BackgroundTransparency = 0.3
Button.BorderSizePixel = 5
Button.Position = UDim2.new(0, 0, 0.5, -25)
Button.Size = UDim2.new(0, 50, 0, 50)
Button.Image = "http://www.roblox.com/asset/?id=176106970"

Bar.Name = "Bar"
Bar.Parent = SpectateGui
Bar.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
Bar.BackgroundTransparency = 0.2
Bar.BorderSizePixel = 5
Bar.Position = UDim2.new(-1, -100, 0.88, -50)
Bar.Size = UDim2.new(0, 200, 0, 50)
Bar.Visible = true

Title.Name = "Title"
Title.Parent = Bar
Title.BackgroundTransparency = 1
Title.Position = UDim2.new(0.25, 0, 0, 0)
Title.Size = UDim2.new(0.3, 0, 1, 0)
Title.Font = Enum.Font.SourceSans
Title.TextColor3 = Color3.fromRGB(255,255,255)
Title.TextScaled = true

Previous.Name = "Previous"
Previous.Parent = Bar
Previous.Size = UDim2.new(0.25, 0, 1, 0)
Previous.Text = "<"
Previous.TextSize = 48
Previous.Font = Enum.Font.SourceSans
Previous.TextColor3 = Color3.fromRGB(255,255,255)

Next.Name = "Next"
Next.Parent = Bar
Next.Position = UDim2.new(0.55, 0, 0, 0)
Next.Size = UDim2.new(0.25, 0, 1, 0)
Next.Text = ">"
Next.TextSize = 48
Next.Font = Enum.Font.SourceSans
Next.TextColor3 = Color3.fromRGB(255,255,255)

Close.Name = "Close"
Close.Parent = Bar
Close.Position = UDim2.new(0.8, 0, 0, 0)
Close.Size = UDim2.new(0.2, 0, 1, 0)
Close.Text = "X"
Close.TextScaled = true
Close.Font = Enum.Font.SourceSansBold
Close.TextColor3 = Color3.fromRGB(255,255,255)
Close.BackgroundColor3 = Color3.fromRGB(170,60,60)

UIGradient.Parent = Next
UIGradient_2.Parent = Previous
UIGradient_3.Parent = Bar

-- LocalScript:

local cam = workspace.CurrentCamera
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local open = false

-- DRAGGING
local dragging = false
local dragStart
local startPos

Bar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = Bar.Position
	end
end)

UIS.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		Bar.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

-- PLAYER INDEX
local function getIndex()
	for i,v in ipairs(game.Players:GetPlayers()) do
		if v.Name == Title.Text then
			return i
		end
	end
end

-- OPEN / CLOSE
Button.MouseButton1Click:Connect(function()
	open = not open

	if open then
		Bar:TweenPosition(UDim2.new(0.5,-100,0.88,-50),"Out","Quad",0.5,true)
		pcall(function()
			Title.Text = game.Players:GetPlayerFromCharacter(cam.CameraSubject.Parent).Name
		end)
	else
		cam.CameraSubject = game.Players.LocalPlayer.Character.Humanoid
		Bar:TweenPosition(UDim2.new(-1,-100,0.88,-50),"In","Quad",0.5,true)
	end
end)

Close.MouseButton1Click:Connect(function()
	open = false
	cam.CameraSubject = game.Players.LocalPlayer.Character.Humanoid
	Bar:TweenPosition(UDim2.new(-1,-100,0.88,-50),"In","Quad",0.5,true)
end)

-- SPECTATE CONTROLS
Previous.MouseButton1Click:Connect(function()
	local players = game.Players:GetPlayers()
	local i = getIndex() or 1
	local target = players[i-1] or players[#players]
	cam.CameraSubject = target.Character.Humanoid
	Title.Text = target.Name
end)

Next.MouseButton1Click:Connect(function()
	local players = game.Players:GetPlayers()
	local i = getIndex() or 1
	local target = players[i+1] or players[1]
	cam.CameraSubject = target.Character.Humanoid
	Title.Text = target.Name
end)

-- GRADIENT ANIMATION
for _,g in ipairs({UIGradient,UIGradient_2,UIGradient_3}) do
	TweenService:Create(
		g,
		TweenInfo.new(5,Enum.EasingStyle.Back,Enum.EasingDirection.InOut,-1,true),
		{Offset = Vector2.new(10,2)}
	):Play()
end
