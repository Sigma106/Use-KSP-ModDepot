jumpBox.Parent = mainFrame

local jumpCorner = Instance.new("UICorner")
jumpCorner.CornerRadius = UDim.new(0, 6)
jumpCorner.Parent = jumpBox

-- Set Jump Button
local setJumpButton = Instance.new("TextButton")
setJumpButton.Size = UDim2.new(0, 120, 0, 40)
setJumpButton.Position = UDim2.new(0, 10, 0, 110)
setJumpButton.Text = "Set Jump"
setJumpButton.BackgroundColor3 = Color3.fromRGB(180, 180, 0)
setJumpButton.TextColor3 = Color3.fromRGB(255, 255, 255)
setJumpButton.Font = Enum.Font.GothamBold
setJumpButton.TextSize = 18
setJumpButton.Parent = mainFrame

local jumpBtnCorner = Instance.new("UICorner")
jumpBtnCorner.CornerRadius = UDim.new(0, 6)
jumpBtnCorner.Parent = setJumpButton

-- Reset Button
local resetButton = Instance.new("TextButton")
resetButton.Size = UDim2.new(0, 120, 0, 40)
resetButton.Position = UDim2.new(0, 160, 0, 110)
resetButton.Text = "Reset"
resetButton.BackgroundColor3 = Color3.fromRGB(70, 70, 200)
resetButton.TextColor3 = Color3.fromRGB(255, 255, 255)
resetButton.Font = Enum.Font.GothamBold
resetButton.TextSize = 18
resetButton.Parent = mainFrame

local resetCorner = Instance.new("UICorner")
resetCorner.CornerRadius = UDim.new(0, 6)
resetCorner.Parent = resetButton

-- Button Functions
setJumpButton.MouseButton1Click:Connect(function()
    local jump = tonumber(jumpBox.Text)
    if jump then
        humanoid.JumpHeight = jump
    end
end)

resetButton.MouseButton1Click:Connect(function()
    humanoid.JumpHeight = originalJump
end)

-- Dragging System
local dragging = false
local dragInput, dragStart, startPos

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

titleBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        dragInput = input
    end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragging and input == dragInput then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)
