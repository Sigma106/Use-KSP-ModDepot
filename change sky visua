-- Modern Sky Changer GUI
local Lighting = game:GetService("Lighting")
local CoreGui = game:GetService("CoreGui")

local EPIC_TEXTURE = "rbxassetid://7817004"
local NIGHT_SKY = {
    SkyboxBk = "rbxassetid://6285719338",
    SkyboxDn = "rbxassetid://6285721078",
    SkyboxFt = "rbxassetid://6285722964",
    SkyboxLf = "rbxassetid://6285724682",
    SkyboxRt = "rbxassetid://6285726335",
    SkyboxUp = "rbxassetid://6285730635"
}

-- Save original skies
local originalSkies = {}
for _, s in pairs(Lighting:GetChildren()) do
    if s:IsA("Sky") then
        table.insert(originalSkies, s:Clone())
    end
end

-- Sky functions
local function clearSkies()
    for _, s in pairs(Lighting:GetChildren()) do
        if s:IsA("Sky") then s:Destroy() end
    end
end

local function setEpicSky()
    clearSkies()
    local sky = Instance.new("Sky")
    sky.Name = "EpicFace"
    sky.SkyboxBk = EPIC_TEXTURE
    sky.SkyboxDn = EPIC_TEXTURE
    sky.SkyboxFt = EPIC_TEXTURE
    sky.SkyboxLf = EPIC_TEXTURE
    sky.SkyboxRt = EPIC_TEXTURE
    sky.SkyboxUp = EPIC_TEXTURE
    sky.StarCount = 3000
    sky.CelestialBodiesShown = true
    sky.Parent = Lighting
end

local function setNightSky()
    clearSkies()
    local sky = Instance.new("Sky")
    sky.Name = "Night"
    for k,v in pairs(NIGHT_SKY) do
        sky[k] = v
    end
    sky.CelestialBodiesShown = false
    sky.Parent = Lighting
end

local function restoreSky()
    clearSkies()
    for _, s in pairs(originalSkies) do
        s:Clone().Parent = Lighting
    end
end

-- GUI
local gui = Instance.new("ScreenGui")
gui.Name = "SkyChangerGui"
gui.Parent = CoreGui

-- Main window
local main = Instance.new("Frame")
main.Size = UDim2.new(0,300,0,260)
main.Position = UDim2.new(0.5,-150,0.5,-130)
main.BackgroundColor3 = Color3.fromRGB(40,40,40)
main.BorderSizePixel = 0
main.Active = true
main.Draggable = true
main.Parent = gui
main.ClipsDescendants = true

-- Shadow effect
local shadow = Instance.new("UICorner")
shadow.CornerRadius = UDim.new(0,12)
shadow.Parent = main

-- Title bar
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1,0,0,40)
title.BackgroundColor3 = Color3.fromRGB(30,30,30)
title.BorderSizePixel = 0
title.Text = "Sky Changer"
title.TextColor3 = Color3.fromRGB(255,255,255)
title.Font = Enum.Font.GothamBold
title.TextSize = 20
title.Parent = main

-- ScrollFrame
local scroll = Instance.new("ScrollingFrame")
scroll.Size = UDim2.new(1,0,1,-40)
scroll.Position = UDim2.new(0,0,0,40)
scroll.BackgroundTransparency = 1
scroll.ScrollBarThickness = 8
scroll.Parent = main
scroll.CanvasSize = UDim2.new(0,0,0,0)

local uiList = Instance.new("UIListLayout")
uiList.Padding = UDim.new(0,10)
uiList.SortOrder = Enum.SortOrder.LayoutOrder
uiList.Parent = scroll

uiList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
    scroll.CanvasSize = UDim2.new(0,0,0,uiList.AbsoluteContentSize.Y + 10)
end)

-- Button creator
local function createButton(parent,text,callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9,0,0,40)
    btn.BackgroundColor3 = Color3.fromRGB(70,70,70)
    btn.BorderSizePixel = 0
    btn.Text = text
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 18
    btn.AutoButtonColor = true

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0,8)
    corner.Parent = btn

    btn.MouseButton1Click:Connect(callback)
    btn.Parent = parent
    return btn
end

-- Buttons
createButton(scroll,"Epic Face Sky",setEpicSky)
createButton(scroll,"Night Sky",setNightSky)
createButton(scroll,"Restore Sky",restoreSky)

-- Close button
local close = Instance.new("TextButton")
close.Size = UDim2.new(0,30,0,30)
close.Position = UDim2.new(1,-35,0,5)
close.Text = "X"
close.BackgroundColor3 = Color3.fromRGB(180,60,60)
close.TextColor3 = Color3.new(1,1,1)
close.Font = Enum.Font.GothamBold
close.TextSize = 18
close.BorderSizePixel = 0
close.Parent = main
close.MouseButton1Click:Connect(function() gui:Destroy() end)

print("Modern Sky Changer GUI loaded")
