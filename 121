-- BUTTON MAKER
local function makeButton(text, y)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(0, 180, 0, 45)
	b.Position = UDim2.new(0, 20, 0, y)
	b.BackgroundColor3 = Color3.fromRGB(45,45,50)
	b.Text = text
	b.Font = Enum.Font.GothamBold
	b.TextSize = 18
	b.TextColor3 = Color3.new(1,1,1)
	b.ZIndex = 2
	b.Parent = main
	Instance.new("UICorner", b)
	return b
end

-- FLY
local flying = false
local flyVel, flyGyro

local flyBtn = makeButton("✈ Fly: OFF", 70)

flyBtn.MouseButton1Click:Connect(function()
	flying = not flying
	flyBtn.Text = flying and "✈ Fly: ON" or "✈ Fly: OFF"

	if flying then
		flyVel = Instance.new("BodyVelocity", root)
		flyGyro = Instance.new("BodyGyro", root)
		flyVel.MaxForce = Vector3.new(1e9,1e9,1e9)
		flyGyro.MaxTorque = Vector3.new(1e9,1e9,1e9)

		RunService:BindToRenderStep("Fly", 1, function()
			local cam = workspace.CurrentCamera
			local dir = Vector3.zero

			if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
			if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
			if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0,1,0) end
			if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.new(0,1,0) end

			flyVel.Velocity = dir * 60
			flyGyro.CFrame = cam.CFrame
		end)
	else
		RunService:UnbindFromRenderStep("Fly")
		if flyVel then flyVel:Destroy() end
		if flyGyro then flyGyro:Destroy() end
	end
end)

-- NOCLIP
local noclip = false
local noclipConn

local noclipBtn = makeButton("🚫 Noclip: OFF", 130)

noclipBtn.MouseButton1Click:Connect(function()
	noclip = not noclip
	noclipBtn.Text = noclip and "🚫 Noclip: ON" or "🚫 Noclip: OFF"

	if noclip then
		noclipConn = RunService.Stepped:Connect(function()
			for _,p in pairs(character:GetDescendants()) do
				if p:IsA("BasePart") then
					p.CanCollide = false
				end
			end
		end)
	else
		if noclipConn then noclipConn:Disconnect() end
	end
end)
