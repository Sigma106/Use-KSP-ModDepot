-- Buttons
local function makeBtn(btn, parent, text, posY)
	btn.Parent = parent
	btn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
	btn.Position = UDim2.new(0.253, 0, posY, 0)
	btn.Size = UDim2.new(0, 251, 0, 50)
	btn.Font = Enum.Font.SourceSans
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(255,255,255)
	btn.TextScaled = true
end

makeBtn(FlyGui, windowmain, "Fly Gui", 0.03)
makeBtn(NoclipGui, windowmain, "Noclip Gui", 0.21)
makeBtn(tprool, windowmain, "TP Tool", 0.39)
makeBtn(Readyinventar, windowmain, "Ready Inventar", 0.58)
makeBtn(brigdetroll, windowmain, "Bridge Troll", 0.79)

