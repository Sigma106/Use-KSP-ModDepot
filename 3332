-- Scripts
Main.MouseButton1Click:Connect(function()
	windowmain.Visible = true
	windowteleport.Visible = false
end)

Teleport.MouseButton1Click:Connect(function()
	windowmain.Visible = false
	windowteleport.Visible = true
end)

tprool.MouseButton1Click:Connect(function()
	local Tele = Instance.new("Tool", game.Players.LocalPlayer.Backpack)
	Tele.RequiresHandle = false
	Tele.Name = "TPTool"
	Tele.Equipped:Connect(function(mouse)
		mouse.Button1Down:Connect(function()
			if mouse.Target then
				game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame =
					CFrame.new(mouse.Hit.X, mouse.Hit.Y + 5, mouse.Hit.Z)
			end
		end)
	end)
end)

NoclipGui.MouseButton1Click:Connect(function()
	loadstring(game:HttpGet("https://raw.githubusercontent.com/Sigma106/Use-KSP-ModDepot/refs/heads/main/efeefefewewfewfefffffffffffffffffff"))()
end)

