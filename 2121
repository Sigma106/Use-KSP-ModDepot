-- ======================
-- LocalScript Logic
-- ======================

local cam = workspace.CurrentCamera
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

-- ===== DRAG IMAGEBUTTON =====
local dragging = false
local dragStart
local startPos

Button.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = Button.Position
	end
end)

UIS.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		Button.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

-- ===== CLOSE IMAGEBUTTON =====
ButtonClose.MouseButton1Click:Connect(function()
	Button.Visible = false
end)

-- ===== REOPEN IMAGEBUTTON (FAILSAFE) =====
UIS.InputBegan:Connect(function(input, gp)
	if not gp and input.KeyCode == Enum.KeyCode.RightShift then
		Button.Visible = true
	end
end)

-- ===== PLAYER INDEX =====
local function getIndex()
	for i,v in ipairs(game.Players:GetPlayers()) do
		if v.Name == Title.Text then
			return i
		end
	end
end

local open = false

-- ===== TOGGLE SPECTATE BAR =====
Button.MouseButton1Click:Connect(function()
	open = not open

	if open then
		Bar:TweenPosition(UDim2.new(0.5,-100,0.88,-50),"Out","Quad",0.5,true)
		pcall(function()
			Title.Text = game.Players:GetPlayerFromCharacter(cam.CameraSubject.Parent).Name
		end)
	else
		pcall(function()
			cam.CameraSubject = game.Players.LocalPlayer.Character.Humanoid
		end)
		Bar:TweenPosition(UDim2.new(-1,-100,0.88,-50),"In","Quad",0.5,true)
	end
end)

-- ===== SPECTATE CONTROLS =====
Previous.MouseButton1Click:Connect(function()
	local players = game.Players:GetPlayers()
	local i = getIndex() or 1
	local target = players[i-1] or players[#players]
	cam.CameraSubject = target.Character.Humanoid
	Title.Text = target.Name
end)

