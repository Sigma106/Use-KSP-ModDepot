-- Custom Sky Loader GUI
local Lighting = game:GetService("Lighting")
local CoreGui = game:GetService("CoreGui")

-- Store custom skies
local customSkies = {} -- {Name = {SkyboxBk=.., SkyboxFt=.., etc.}}

-- Function to clear current skies
local function clearSkies()
    for _, s in pairs(Lighting:GetChildren()) do
        if s:IsA("Sky") then s:Destroy() end
    end
end

-- Function to apply a sky by data table
local function applySky(skyData)
    clearSkies()
    local sky = Instance.new("Sky")
    sky.Name = skyData.Name or "CustomSky"
    for k,v in pairs(skyData) do
        if k ~= "Name" then
            sky[k] = v
        end
    end
    sky.Parent = Lighting
end

-- GUI
local gui = Instance.new("ScreenGui")
gui.Name = "CustomSkyGui"
gui.Parent = CoreGui

local main = Instance.new("Frame")
main.Size = UDim2.new(0,300,0,220)
