-- Sky & Global Texture Changer GUI (Full Version)
-- Changes ALL textures in Workspace + sky
local Lighting = game:GetService("Lighting")
local CoreGui = game:GetService("CoreGui")
local Workspace = game:GetService("Workspace")

local EPIC_TEXTURE = "rbxassetid://7817004"

-- Remove old GUI
pcall(function() CoreGui:FindFirstChild("SkyTextureGui"):Destroy() end)

-- Save original skies
local originalSkies = {}
for _, s in pairs(Lighting:GetChildren()) do
    if s:IsA("Sky") then
        table.insert(originalSkies, s:Clone())
    end
end

-- Save all original textures
local originalTextures = {}
local function saveAllOriginalTextures()
    for _, obj in pairs(Workspace:GetDescendants()) do
        pcall(function()
            if obj:IsA("Decal") or obj:IsA("Texture") then
                originalTextures[obj] = originalTextures[obj] or {}
                originalTextures[obj].Texture = obj.Texture
            elseif obj:IsA("MeshPart") then
                originalTextures[obj] = originalTextures[obj] or {}
                originalTextures[obj].TextureID = obj.TextureID
            elseif obj:IsA("SpecialMesh") then
                originalTextures[obj] = originalTextures[obj] or {}
                originalTextures[obj].TextureId = obj.TextureId
            elseif obj:IsA("SurfaceAppearance") then
                originalTextures[obj] = originalTextures[obj] or {}
                originalTextures[obj].Texture = obj.Texture
            end
        end)
    end
end
saveAllOriginalTextures()

-- Sky Functions
local function clearSkies()
    for _, s in pairs(Lighting:GetChildren()) do
        if s:IsA("Sky") then s:Destroy() end
    end
end

local function epicFaceSky()
    clearSkies()
    local sky = Instance.new("Sky")
    sky.Name = "EpicFace"
    local id = EPIC_TEXTURE
    sky.SkyboxBk, sky.SkyboxDn, sky.SkyboxFt = id,id,id
    sky.SkyboxLf, sky.SkyboxRt, sky.SkyboxUp = id,id,id
    sky.StarCount = 3000
    sky.CelestialBodiesShown = true
    sky.Parent = Lighting
end

local function nightSky()
    clearSkies()
    local sky = Instance.new("Sky")
    sky.Name = "Night"
    sky.SkyboxBk = "rbxassetid://6285719338"
    sky.SkyboxDn = "rbxassetid://6285721078"
    sky.SkyboxFt = "rbxassetid://6285722964"
    sky.SkyboxLf = "rbxassetid://6285724682"
    sky.SkyboxRt = "rbxassetid://6285726335"
    sky.SkyboxUp = "rbxassetid://6285730635"
    sky.CelestialBodiesShown = false
    sky.Parent = Lighting
end

local function restoreSky()
    clearSkies()
    for _, s in pairs(originalSkies) do
        s:Clone().Parent = Lighting
    end
end

-- Texture Functions
local function applyEpicTexturesAll()
    for _, obj in pairs(Workspace:GetDescendants()) do
        pcall(function()
            if obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Texture = EPIC_TEXTURE
            elseif obj:IsA("MeshPart") then
                obj.TextureID = EPIC_TEXTURE
            elseif obj:IsA("SpecialMesh") then
                obj.TextureId = EPIC_TEXTURE
            elseif obj:IsA("SurfaceAppearance") then
                obj.Texture = EPIC_TEXTURE
            end
        end)
    end
end

local function restoreTexturesAll()
    for obj, props in pairs(originalTextures) do
        if obj and obj.Parent then
            pcall(function()
                for propName, val in pairs(props) do
                    obj[propName] = val
                end
            end)
        end
    end
end

