-- Buttons
local function makeButton(text, yPos, color, callback)
    local btn = Instance.new("TextButton", frame)
    btn.Size = UDim2.new(0.85, 0, 0, 38)
    btn.Position = UDim2.new(0.075, 0, yPos, 0)
    btn.Text = text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    btn.TextColor3 = Color3.new(1,1,1)
    btn.BackgroundColor3 = color
    btn.BorderSizePixel = 0
    btn.ZIndex = 11
    Instance.new("UICorner", btn)
    btn.MouseButton1Click:Connect(callback)
end

makeButton("Epic Face Sky", 0.28, Color3.fromRGB(70,130,220), epicFaceSky)
makeButton("Night Sky", 0.50, Color3.fromRGB(80,80,120), nightSky)
makeButton("Restore Original", 0.72, Color3.fromRGB(90,90,90), restoreSky)

print("Sky GUI loaded (Epic Face + Night)")
