    skyPage.Visible = true
    texPage.Visible = false
    tabSky.BackgroundColor3 = Color3.fromRGB(60,60,60)
    tabTex.BackgroundColor3 = Color3.fromRGB(40,40,40)
end)

tabTex.MouseButton1Click:Connect(function()
