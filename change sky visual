-- HARD FIXED Sky + Texture GUI (Executor Safe)

local Lighting = game:GetService("Lighting")
local CoreGui = game:GetService("CoreGui")
local Workspace = game:GetService("Workspace")

-- Remove old GUI
pcall(function()
    CoreGui:FindFirstChild("SkyTextureGui"):Destroy()
end)

-- Save original sky
local originalSky = {}
for _, s in pairs(Lighting:GetChildren()) do
    if s:IsA("Sky") then
        table.insert(originalSky, s:Clone())
    end
end

-- Save original textures
local originalTextures = {}
for _, obj in ipairs(Workspace:GetDescendants()) do
    if obj:IsA("Decal") or obj:IsA("Texture") then
        originalTextures[obj] = obj.Texture
    elseif obj:IsA("MeshPart") then
        originalTextures[obj] = obj.TextureID
    elseif obj:IsA("SpecialMesh") then
        originalTextures[obj] = obj.TextureId
    end
end

-- Utils
local function clearSkies()
    for _, s in pairs(Lighting:GetChildren()) do
        if s:IsA("Sky") then s:Destroy() end
    end
end

-- Epic Face Sky
local function epicFaceSky()
    clearSkies()
    local sky = Instance.new("Sky")
    local id = "rbxassetid://7817004"
    sky.Name = "EpicFace"
    sky.SkyboxBk, sky.SkyboxDn, sky.SkyboxFt = id,id,id
    sky.SkyboxLf, sky.SkyboxRt, sky.SkyboxUp = id,id,id
    sky.StarCount = 3000
    sky.CelestialBodiesShown = true
    sky.Parent = Lighting
end

-- Night Sky
local function nightSky()
    clearSkies()
    local sky = Instance.new("Sky")
    sky.Name = "Night"
    sky.SkyboxBk = "rbxassetid://6285719338"
    sky.SkyboxDn = "rbxassetid://6285721078"
    sky.SkyboxFt = "rbxassetid://6285722964"
    sky.SkyboxLf = "rbxassetid://6285724682"
    sky.SkyboxRt = "rbxassetid://6285726335"
    sky.SkyboxUp = "rbxassetid://6285730635"
    sky.CelestialBodiesShown = false
    sky.Parent = Lighting
end

-- Restore sky
local function restoreSky()
    clearSkies()
    for _, s in pairs(originalSky) do
        s:Clone().Parent = Lighting
    end
end

-- Epic Face textures
local EPIC = "rbxassetid://7817004"
local function epicTextures()
    for obj,_ in pairs(originalTextures) do
        if obj and obj.Parent then
            if obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Texture = EPIC
            elseif obj:IsA("MeshPart") then
                obj.TextureID = EPIC
            elseif obj:IsA("SpecialMesh") then
                obj.TextureId = EPIC
            end
        end
    end
end

-- Restore textures
local function restoreTextures()
    for obj,tex in pairs(originalTextures) do
        if obj and obj.Parent then
            if obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Texture = tex
            elseif obj:IsA("MeshPart") then
                obj.TextureID = tex
            elseif obj:IsA("SpecialMesh") then
                obj.TextureId = tex
            end
        end
    end
end

