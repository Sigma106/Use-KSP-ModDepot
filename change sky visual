-- Custom Sky Loader GUI (Bottom-Right Upwards)
local Lighting = game:GetService("Lighting")
local CoreGui = game:GetService("CoreGui")

local customSkies = {} -- {Name = {SkyboxBk=.., SkyboxFt=.., ...}}

-- Functions
local function clearSkies()
    for _, s in pairs(Lighting:GetChildren()) do
        if s:IsA("Sky") then s:Destroy() end
    end
end

local function applySky(skyData)
    clearSkies()
    local sky = Instance.new("Sky")
    sky.Name = skyData.Name or "CustomSky"
    for k,v in pairs(skyData) do
        if k ~= "Name" then
            sky[k] = v
        end
    end
    sky.Parent = Lighting
end

-- GUI
local gui = Instance.new("ScreenGui")
gui.Name = "CustomSkyBottomRight"
gui.Parent = CoreGui

local main = Instance.new("Frame")
main.Size = UDim2.new(0,300,0,100)
main.Position = UDim2.new(1,-310,1,-110) -- bottom-right
main.BackgroundColor3 = Color3.fromRGB(35,35,35)
main.BorderSizePixel = 0
main.Active = true
main.Draggable = true
main.ClipsDescendants = true
main.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0,12)
corner.Parent = main

-- Title
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1,0,0,30)
title.BackgroundColor3 = Color3.fromRGB(25,25,25)
title.BorderSizePixel = 0
title.Text = "Custom Sky Loader"
title.TextColor3 = Color3.new(1,1,1)
title.Font = Enum.Font.GothamBold
title.TextSize = 16
title.Parent = main

-- Input box for asset ID
local inputBox = Instance.new("TextBox")
inputBox.Size = UDim2.new(0.7,0,0,30)
inputBox.Position = UDim2.new(0.05,0,0,35)
inputBox.PlaceholderText = "Enter Asset ID"
inputBox.Text = ""
inputBox.ClearTextOnFocus = false
inputBox.BackgroundColor3 = Color3.fromRGB(50,50,50)
inputBox.TextColor3 = Color3.new(1,1,1)
inputBox.Font = Enum.Font.Gotham
inputBox.TextSize = 16
inputBox.BorderSizePixel = 0
local cornerInput = Instance.new("UICorner")
cornerInput.CornerRadius = UDim.new(0,6)
cornerInput.Parent = inputBox
inputBox.Parent = main

-- Add button
local addBtn = Instance.new("TextButton")
addBtn.Size = UDim2.new(0.2,0,0,30)
addBtn.Position = UDim2.new(0.78,0,0,35)
addBtn.Text = "Add"
addBtn.BackgroundColor3 = Color3.fromRGB(70,70,70)
addBtn.TextColor3 = Color3.new(1,1,1)
addBtn.Font = Enum.Font.GothamBold
addBtn.TextSize = 16
local cornerBtn = Instance.new("UICorner")
cornerBtn.CornerRadius = UDim.new(0,6)
cornerBtn.Parent = addBtn
addBtn.Parent = main

-- Frame for sky buttons (grow upward)
local btnFrame = Instance.new("Frame")
btnFrame.Size = UDim2.new(0.95,0,0,150)
btnFrame.Position = UDim2.new(0.025,0,0,-150) -- will grow upward
btnFrame.BackgroundTransparency = 1
btnFrame.Parent = main

local uiList = Instance.new("UIListLayout")
uiList.SortOrder = Enum.SortOrder.LayoutOrder
uiList.FillDirection = Enum.FillDirection.Vertical
uiList.Padding = UDim.new(0,6)
uiList.Parent = btnFrame
uiList.HorizontalAlignment = Enum.HorizontalAlignment.Right
uiList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
    btnFrame.Size = UDim2.new(0.95,0,0,uiList.AbsoluteContentSize.Y)
    btnFrame.Position = UDim2.new(0.025,0,0,-uiList.AbsoluteContentSize.Y)
end)

-- Function to create sky button
local function createSkyButton(name, skyData)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1,0,0,30)
    btn.BackgroundColor3 = Color3.fromRGB(70,70,70)
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    btn.Text = name
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0,5)
    corner.Parent = btn
    btn.MouseButton1Click:Connect(function()
        applySky(skyData)
    end)
    btn.Parent = btnFrame
end

-- Add button functionality
addBtn.MouseButton1Click:Connect(function()
    local id = inputBox.Text:match("%d+")
    if id and id ~= "" then
        local skyName = "Sky "..(#customSkies + 1)
        local skyData = {
            Name = skyName,
            SkyboxBk = "rbxassetid://"..id,
            SkyboxFt = "rbxassetid://"..id,
            SkyboxLf = "rbxassetid://"..id,
            SkyboxRt = "rbxassetid://"..id,
            SkyboxUp = "rbxassetid://"..id,
            SkyboxDn = "rbxassetid://"..id
        }
        customSkies[skyName] = skyData
        createSkyButton(skyName, skyData)
        inputBox.Text = ""
    end
end)

-- Close button
local close = Instance.new("TextButton")
close.Size = UDim2.new(0,30,0,30)
close.Position = UDim2.new(1,-35,0,5)
close.Text = "X"
close.BackgroundColor3 = Color3.fromRGB(180,60,60)
close.TextColor3 = Color3.new(1,1,1)
close.Font = Enum.Font.GothamBold
close.TextSize = 18
close.BorderSizePixel = 0
close.Parent = main
close.MouseButton1Click:Connect(function() gui:Destroy() end)

print("Bottom-Right Upward Sky Loader GUI loaded")
