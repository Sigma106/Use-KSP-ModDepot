local flyCorner = Instance.new("UICorner")
flyCorner.CornerRadius = UDim.new(0,8)
flyCorner.Parent = flySpeedBox

flySpeedBox.FocusLost:Connect(function()
    local val = tonumber(flySpeedBox.Text)
    if val and val > 0 then
        flySpeed = val
        flySpeedBox.Text = ""
        flySpeedBox.PlaceholderText = "Fly Speed: "..flySpeed
    else
        flySpeedBox.Text = ""
        flySpeedBox.PlaceholderText = "Invalid value!"
    end
end)

-- Noclip & Fly Implementation
RunService.Stepped:Connect(function()
    if noclipActive then
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end

    if flyActive and bodyVelocity then
        local direction = Vector3.new()
        local cam = workspace.CurrentCamera
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then direction += cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then direction -= cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then direction -= cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then direction += cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then direction += Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then direction -= Vector3.new(0,1,0) end

        if direction.Magnitude > 0 then
            bodyVelocity.Velocity = direction.Unit * flySpeed
        else
            bodyVelocity.Velocity = Vector3.new(0,0,0)
        end
    end
end)

-- Manual Drag
local dragging = false
local dragOffset = Vector2.new()

Title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        local mousePos = input.Position
        dragOffset = Vector2.new(mousePos.X - MainFrame.AbsolutePosition.X, mousePos.Y - MainFrame.AbsolutePosition.Y)
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)

Title.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        RunService.RenderStepped:Connect(function()
            if dragging then
                local mousePos = UserInputService:GetMouseLocation()
                MainFrame.Position = UDim2.new(0, mousePos.X - dragOffset.X, 0, mousePos.Y - dragOffset.Y)
            end
        end)
    end
end)

-- Resizable Corner
local resizeCorner = Instance.new("Frame")
resizeCorner.Size = UDim2.new(0,20,0,20)
resizeCorner.Position = UDim2.new(1,-20,1,-20)
resizeCorner.BackgroundColor3 = Color3.fromRGB(80,80,100)
resizeCorner.BorderSizePixel = 0
resizeCorner.Parent = MainFrame

local resizeCornerUIC = Instance.new("UICorner")
resizeCornerUIC.CornerRadius = UDim.new(0,4)
resizeCornerUIC.Parent = resizeCorner

local resizing = false
local startSize = Vector2.new()
local startPos = Vector2.new()

resizeCorner.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        resizing = true
        startSize = Vector2.new(MainFrame.AbsoluteSize.X, MainFrame.AbsoluteSize.Y)
        startPos = input.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then resizing = false end
        end)
    end
end)

RunService.RenderStepped:Connect(function()
    if resizing then
        local delta = UserInputService:GetMouseLocation() - startPos
        local newX = math.clamp(startSize.X + delta.X,150,800)
        local newY = math.clamp(startSize.Y + delta.Y,200,600)
        MainFrame.Size = UDim2.new(0,newX,0,newY)
    end
end)
