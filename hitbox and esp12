--// SERVICES
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

--// HITBOX STATE
local HitboxEnabled = false
Togglehitboxbutton.Text = "Hitbox OFF"

local HitboxSizeValue = tonumber(HitboxSizetextbox.Text) or 10
local HitboxTransparencyValue = tonumber(ApplyTransparencytextbox.Text) or 0
local HitboxBrickColor = BrickColor.new("Really red")

--// CLOSE GUI
buttonclose.MouseButton1Click:Connect(function()
	ScreenGui:Destroy()
end)

--// MINIMIZE GUI
local minimized = false
buttonminimaze.MouseButton1Click:Connect(function()
	minimized = not minimized
	window.Visible = not minimized
end)

--// TOGGLE HITBOX (FIXED)
Togglehitboxbutton.MouseButton1Click:Connect(function()
	HitboxEnabled = not HitboxEnabled
	Togglehitboxbutton.Text = HitboxEnabled and "Hitbox ON" or "Hitbox OFF"
end)

--// APPLY HITBOX SIZE
applyhitboxsizebutton.MouseButton1Click:Connect(function()
	local size = tonumber(HitboxSizetextbox.Text)
	if size and size >= 2 and size <= 100 then
		HitboxSizeValue = size
	end
end)

--// APPLY TRANSPARENCY
ApplyTransparencybutton.MouseButton1Click:Connect(function()
	local t = tonumber(ApplyTransparencytextbox.Text)
	if t then
		HitboxTransparencyValue = math.clamp(t, 0, 1)
	end
end)

--// HEX → BRICKCOLOR
local function HexToBrickColor(hex)
	hex = hex:gsub("#","")
	if #hex ~= 6 then return end
	return BrickColor.new(Color3.fromRGB(
		tonumber(hex:sub(1,2),16),
		tonumber(hex:sub(3,4),16),
		tonumber(hex:sub(5,6),16)
		))
end

--// APPLY COLOR
ApplyColorbutton.MouseButton1Click:Connect(function()
	local bc = HexToBrickColor(colorhitboxtextbox.Text)
	if bc then
		HitboxBrickColor = bc
	end
end)

--// CREATE / UPDATE HITBOX
local function updateHitbox(character)
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local hb = character:FindFirstChild("FakeHitbox")

	if not hb then
		hb = Instance.new("Part")
		hb.Name = "FakeHitbox"
		hb.Anchored = false
		hb.CanCollide = false
		hb.Massless = true
		hb.Material = Enum.Material.Neon
		hb.Parent = character

		local weld = Instance.new("WeldConstraint")
		weld.Part0 = hb
		weld.Part1 = hrp
		weld.Parent = hb
	end

	hb.Size = Vector3.new(HitboxSizeValue, HitboxSizeValue, HitboxSizeValue)
	hb.CFrame = hrp.CFrame
	hb.Transparency = HitboxTransparencyValue
	hb.BrickColor = HitboxBrickColor
end

--// MAIN LOOP
RunService.RenderStepped:Connect(function()
	for _, player in pairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			if HitboxEnabled then
				updateHitbox(player.Character)
			else
				local hb = player.Character:FindFirstChild("FakeHitbox")
				if hb then hb:Destroy() end
			end
		end
	end
end)
