-- HITBOX SYSTEM (FAKE PART – STABLE)
----------------------------------------------------------------
local HitboxEnabled = false
local HitboxSize = 10
local HitboxTransparency = 0
local HitboxColor = BrickColor.new("Really red")

local ToggleHitbox = Instance.new("TextButton", HitboxPage)
ToggleHitbox.Size = UDim2.new(1, 0, 0, 35)
ToggleHitbox.Text = "Hitbox OFF"
ToggleHitbox.BackgroundColor3 = Color3.fromRGB(45,45,45)
ToggleHitbox.TextColor3 = Color3.new(1,1,1)

ToggleHitbox.MouseButton1Click:Connect(function()
	HitboxEnabled = not HitboxEnabled
	ToggleHitbox.Text = HitboxEnabled and "Hitbox ON" or "Hitbox OFF"
end)

local SizeBox = Instance.new("TextBox", HitboxPage)
SizeBox.Position = UDim2.new(0,0,0,45)
SizeBox.Size = UDim2.new(1,0,0,30)
SizeBox.Text = "10"

local ApplySize = Instance.new("TextButton", HitboxPage)
ApplySize.Position = UDim2.new(0,0,0,80)
ApplySize.Size = UDim2.new(1,0,0,30)
ApplySize.Text = "Apply Size"

ApplySize.MouseButton1Click:Connect(function()
	local n = tonumber(SizeBox.Text)
	if n then HitboxSize = math.clamp(n,2,100) end
end)

local ColorBox = Instance.new("TextBox", HitboxPage)
ColorBox.Position = UDim2.new(0,0,0,120)
ColorBox.Size = UDim2.new(1,0,0,30)
ColorBox.Text = "#FF0000"

local ApplyColor = Instance.new("TextButton", HitboxPage)
ApplyColor.Position = UDim2.new(0,0,0,155)
ApplyColor.Size = UDim2.new(1,0,0,30)
ApplyColor.Text = "Apply Color"

local function HexToBrick(hex)
	hex = hex:gsub("#","")
	if #hex ~= 6 then return end
	return BrickColor.new(Color3.fromRGB(
		tonumber(hex:sub(1,2),16),
		tonumber(hex:sub(3,4),16),
		tonumber(hex:sub(5,6),16)
	))
end

ApplyColor.MouseButton1Click:Connect(function()
	local bc = HexToBrick(ColorBox.Text)
	if bc then HitboxColor = bc end
end)

local TransBox = Instance.new("TextBox", HitboxPage)
TransBox.Position = UDim2.new(0,0,0,195)
TransBox.Size = UDim2.new(1,0,0,30)
TransBox.Text = "0"

local ApplyTrans = Instance.new("TextButton", HitboxPage)
ApplyTrans.Position = UDim2.new(0,0,0,230)
ApplyTrans.Size = UDim2.new(1,0,0,30)
ApplyTrans.Text = "Apply Transparency"

ApplyTrans.MouseButton1Click:Connect(function()
	local t = tonumber(TransBox.Text)
	if t then HitboxTransparency = math.clamp(t,0,1) end
end)

local function updateHitbox(char)
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local hb = char:FindFirstChild("FakeHitbox")

	if not hb then
		hb = Instance.new("Part", char)
		hb.Name = "FakeHitbox"
		hb.Anchored = false
		hb.CanCollide = false
		hb.Massless = true
		hb.Material = Enum.Material.Neon
		Instance.new("WeldConstraint", hb).Part1 = hrp
		hb.WeldConstraint.Part0 = hb
	end

	hb.Size = Vector3.new(HitboxSize,HitboxSize,HitboxSize)
	hb.CFrame = hrp.CFrame
	hb.Transparency = HitboxTransparency
	hb.BrickColor = HitboxColor
end

