-- DRAGGING
do
	local dragging, offset
	title.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			offset = i.Position - main.AbsolutePosition
		end
	end)
	title.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseMovement and dragging then
			main.Position = UDim2.fromOffset(i.Position.X - offset.X, i.Position.Y - offset.Y)
		end
	end)
end

-- TAB BUTTONS
local tabFrame = Instance.new("Frame", main)
tabFrame.Size = UDim2.new(1,0,0,40)
tabFrame.Position = UDim2.fromOffset(0,40)
tabFrame.BackgroundTransparency = 1

local contentFrame = Instance.new("Frame", main)
contentFrame.Size = UDim2.new(1,-20,1,-100)
contentFrame.Position = UDim2.fromOffset(10,90)
contentFrame.BackgroundTransparency = 1

local tabs = {}
local activeTab = nil

local function createTab(name)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0,100,1,0)
	btn.Text = name
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 16
	btn.TextColor3 = Color3.new(1,1,1)
	btn.BackgroundColor3 = Color3.fromRGB(50,50,70)
	Instance.new("UICorner", btn)
	btn.Parent = tabFrame
	btn.Position = UDim2.new(0,#tabs*0,0,0)
	tabs[name] = {Button = btn, Frame = Instance.new("Frame")}
	tabs[name].Frame.Size = contentFrame.Size
	tabs[name].Frame.Position = UDim2.fromOffset(0,0)
	tabs[name].Frame.BackgroundTransparency = 1
	tabs[name].Frame.Parent = contentFrame
	tabs[name].Frame.Visible = false

	btn.MouseButton1Click:Connect(function()
		if activeTab then
			tabs[activeTab].Frame.Visible = false
		end
		activeTab = name
		tabs[name].Frame.Visible = true
	end)
	return tabs[name].Frame
end

-- UTILITY FUNCTIONS
local function button(parent, text, callback)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1,0,0,45)
	b.Text = text
	b.Font = Enum.Font.GothamBold
	b.TextSize = 16
	b.TextColor3 = Color3.new(1,1,1)
	b.BackgroundColor3 = Color3.fromRGB(60,60,90)
	Instance.new("UICorner", b)
	b.Parent = parent
	b.MouseButton1Click:Connect(callback)
	return b
end

local function inputBox(parent, placeholder, callback)
	local t = Instance.new("TextBox")
	t.Size = UDim2.new(1,0,0,45)
	t.PlaceholderText = placeholder
	t.Text = ""
	t.Font = Enum.Font.GothamBold
	t.TextSize = 16
	t.TextColor3 = Color3.new(1,1,1)
	t.BackgroundColor3 = Color3.fromRGB(50,50,80)
	Instance.new("UICorner", t)
	t.Parent = parent
	t.FocusLost:Connect(function()
		local val = tonumber(t.Text)
		if val then callback(val) end
		t.Text = ""
	end)
	return t
end

-- CREATE TABS
local playerTab = createTab("Player")
local movementTab = createTab("Movement")

-- ADD CONTENT TO PLAYER TAB
local flyActive = false
local noclipActive = false
local flySpeed = 60
local bv

button(playerTab, "Toggle Fly", function()
	flyActive = not flyActive
	if flyActive then
		bv = Instance.new("BodyVelocity", root)
		bv.MaxForce = Vector3.new(1e5,1e5,1e5)
	else
		if bv then bv:Destroy() end
	end
end)

inputBox(playerTab, "Fly Speed", function(v) flySpeed = math.clamp(v,10,300) end)
button(playerTab, "Toggle Noclip", function() noclipActive = not noclipActive end)
inputBox(playerTab, "WalkSpeed", function(v) hum.WalkSpeed = math.clamp(v,5,300) end)
inputBox(playerTab, "JumpPower", function(v) hum.JumpPower = math.clamp(v,10,300) end)

-- ADD CONTENT TO MOVEMENT TAB
-- Example toggle for fast sprint
local fastSprint = false
button(movementTab, "Toggle Fast Sprint", function() fastSprint = not fastSprint end)
inputBox(movementTab, "Sprint Speed", function(v)
	if fastSprint then hum.WalkSpeed = v end
end)

-- LOOPS
RunService.Stepped:Connect(function()
	if noclipActive then
		for _,p in ipairs(char:GetDescendants()) do
			if p:IsA("BasePart") then p.CanCollide = false end
		end
	end
end)

RunService.RenderStepped:Connect(function()
	if flyActive and bv then
		local dir = Vector3.zero
		if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
		if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.yAxis end
		bv.Velocity = (dir.Magnitude > 0) and dir.Unit*flySpeed or Vector3.zero
	end
end)
